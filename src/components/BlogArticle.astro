---
import BaseLayout from "../layouts/BaseLayout.astro";
import BlogCard from "./BlogCard.astro";
import { relatedPosts, type BlogPost } from "../data/blog";

interface Props {
  post: BlogPost;
}

const { post } = Astro.props;
const related = relatedPosts(post.slug);
---

<BaseLayout title={post.title} description={post.description}>
  <article class="blog-article">
    <section class="article-hero" aria-labelledby="article-title">
      <div class="article-hero__stage">
        <div class="article-hero__art" aria-hidden="true">
          <div class="article-hero__blur"></div>
          <img class="article-hero__pattern" src="/assets/framerusercontent.com/images/IaNCr2d8JUTUZ2bOx135NYqB2wQ.svg" alt="" />
          <img class="article-hero__vector article-hero__vector--top" src="/assets/framerusercontent.com/images/9APaz5YMgQECkE1T48f88rrLqA.svg" alt="" />
          <img class="article-hero__vector article-hero__vector--bottom" src="/assets/framerusercontent.com/images/kDa223DGZcZDfotnhFbOWGrSUx0.svg" alt="" />
        </div>
        <div class="article-hero__container">
          <div class="article-hero__intro">
            <p class="article-date" data-hero-reveal data-delay="100">{post.date}</p>
            <h1 id="article-title" data-hero-reveal data-delay="200">{post.title}</h1>
            <p class="article-description" data-hero-reveal data-delay="300">{post.description}</p>
          </div>
          <div class="article-hero__image" data-hero-reveal data-delay="400">
            <img src={post.image} width="1200" height="660" alt="Blog Image" fetchpriority="high" />
          </div>
        </div>
      </div>
    </section>

    <div class="article-copy prose">
      {post.sections.map((section, sectionIndex) => (
        <section class="article-section" aria-labelledby={`${post.slug}-${section.heading.toLowerCase().replaceAll(" ", "-")}`}>
          {sectionIndex === 0 ? (
            <h2 id={`${post.slug}-${section.heading.toLowerCase().replaceAll(" ", "-")}`}>{section.heading}</h2>
          ) : (
            <h3 id={`${post.slug}-${section.heading.toLowerCase().replaceAll(" ", "-")}`}>{section.heading}</h3>
          )}
          {section.blocks.map((block) => {
            if (block.kind === "paragraph") return <p>{block.text}</p>;
            if (block.kind === "quote") return <p>{block.text}</p>;
            if (block.kind === "bullets") {
              return <ul>{block.items.map((item) => <li><p>{item}</p></li>)}</ul>;
            }
            return <p class="article-lines">{block.items.map((item, itemIndex) => <>{item}{itemIndex < block.items.length - 1 && <br />}</>)}</p>;
          })}
        </section>
      ))}
    </div>

    <section class="related" aria-labelledby="related-title">
      <div class="related__inner">
        <h2 id="related-title">Other blogs</h2>
        <div class="related-grid">
          {related.map((relatedPost) => <BlogCard post={relatedPost} />)}
        </div>
      </div>
    </section>
  </article>
</BaseLayout>

<style>
  .blog-article {
    padding-bottom: 0;
  }

  .article-hero {
    width: calc(100% - 28px);
    margin: 14px auto 0;
    padding: 96px 30px 70px;
    border-radius: 12px;
  }

  .article-hero__intro {
    display: grid;
    justify-items: center;
    max-width: 700px;
    margin-inline: auto;
    text-align: center;
  }

  .article-date {
    padding: 7px 12px;
    border: 1px solid rgba(255, 255, 255, 0.1);
    border-radius: 10px;
    background: rgba(255, 255, 255, 0.1);
    color: #fff;
    font-size: 12px;
    line-height: 1;
  }

  .article-hero h1 {
    max-width: 640px;
    margin-top: 22px;
    color: #fff;
    font-size: clamp(44px, 4.65vw, 66px);
    line-height: 1.02;
  }

  .article-description {
    max-width: 600px;
    margin-top: 16px;
    color: var(--soft);
    font-size: 14px;
    line-height: 1.35;
  }

  .article-hero__image {
    width: min(1180px, 100%);
    margin: 48px auto 0;
    overflow: hidden;
    aspect-ratio: 1.81818;
    border-radius: 12px;
  }

  .article-hero__image img {
    width: 100%;
    height: 100%;
    object-fit: cover;
  }

  .article-copy {
    max-width: 770px;
    margin-top: 47px;
  }

  .article-section + .article-section {
    margin-top: 31px;
  }

  .article-copy h2 {
    margin: 0 0 9px;
    font-size: clamp(25px, 2.5vw, 34px);
    line-height: 1.1;
  }

  .article-copy p,
  .article-copy li,
  .article-copy blockquote {
    color: rgb(84, 84, 84);
    font-size: 14px;
    line-height: 1.35;
    white-space: pre-wrap;
    overflow-wrap: break-word;
  }

  .article-copy p {
    margin-bottom: 11px;
  }

  .article-copy ul {
    margin: 0;
    padding-left: 19px;
  }

  .article-copy li + li {
    margin-top: 2px;
  }

  .article-copy blockquote {
    margin: 7px 0 0;
    font-style: normal;
  }

  .related {
    margin-top: 110px;
    padding-bottom: 68px;
  }

  .related__inner {
    width: min(calc(100% - 120px), 1180px);
    margin-inline: auto;
  }

  .related h2 {
    margin-bottom: 34px;
    font-size: clamp(36px, 3.4vw, 52px);
    line-height: 1;
  }

  .related-grid {
    display: grid;
    grid-template-columns: repeat(3, minmax(0, 1fr));
    gap: 20px;
  }

  .related-grid :global(.blog-card h2) {
    font-size: 16px;
  }

  @media (max-width: 1199px) {
    .article-hero {
      width: calc(100% - 20px);
      margin-top: 38px;
      padding: 64px 10px 44px;
    }

    .article-hero h1 {
      font-size: 44px;
    }

    .article-hero__image {
      margin-top: 27px;
    }

    .article-copy {
      max-width: 760px;
      margin-top: 37px;
    }

    .related {
      margin-top: 93px;
    }

    .related__inner {
      width: calc(100% - 28px);
    }
  }

  @media (max-width: 809px) {
    .article-hero {
      width: calc(100% - 8px);
      margin-top: 20px;
      padding: 28px 8px 27px;
      border-radius: 9px;
    }

    .article-date {
      padding: 5px 9px;
      font-size: 9px;
    }

    .article-hero h1 {
      max-width: 335px;
      margin-top: 11px;
      font-size: 22px;
      line-height: 1.02;
    }

    .article-description {
      max-width: 280px;
      margin-top: 11px;
      font-size: 10px;
      line-height: 1.25;
    }

    .article-hero__image {
      margin-top: 12px;
      border-radius: 8px;
    }

    .article-copy {
      width: calc(100% - 16px);
      margin-top: 30px;
    }

    .article-section + .article-section {
      margin-top: 26px;
    }

    .article-copy h2 {
      margin-bottom: 7px;
      font-size: 20px;
      line-height: 1.05;
    }

    .article-copy p,
    .article-copy li,
    .article-copy blockquote {
      font-size: 11px;
      line-height: 1.3;
    }

    .article-copy p {
      margin-bottom: 8px;
    }

    .article-copy ul {
      padding-left: 15px;
    }

    .related {
      margin-top: 62px;
      padding-bottom: 29px;
    }

    .related__inner {
      width: calc(100% - 16px);
    }

    .related h2 {
      margin-bottom: 16px;
      font-size: 24px;
    }

    .related-grid {
      grid-template-columns: 1fr;
      gap: 18px;
    }

    .related-grid :global(.blog-card h2) {
      font-size: 14px;
    }
  }
  /* The oracle uses a full-width section with an inset, artwork-backed stage. */
  .article-hero {
    width: 100%;
    margin: 0;
    padding: 0 30px 70px;
    background: transparent;
  }

  .article-hero__stage {
    position: relative;
    width: 100%;
    overflow: clip;
    padding: 150px 30px 70px;
    border-radius: 20px;
    background: #0a0b0b;
  }

  .article-hero__container {
    position: relative;
    z-index: 1;
    display: flex;
    width: min(100%, 1180px);
    flex-direction: column;
    align-items: center;
    gap: 50px;
    margin-inline: auto;
  }

  .article-hero__intro {
    display: flex;
    width: 100%;
    flex-direction: column;
    align-items: center;
    gap: 10px;
  }

  .article-hero__intro h1,
  .article-hero__intro .article-description {
    margin: 0;
  }

  .article-date {
    padding: 7px 12px;
    font-size: 14px;
    line-height: 16.8px;
  }

  .article-hero h1 {
    max-width: 700px;
    font-size: 62px;
    line-height: 1.1;
    letter-spacing: 0;
    text-wrap: balance;
  }

  .article-description {
    max-width: 700px;
    font-size: 18px;
    line-height: 1.4;
    text-wrap: balance;
  }

  .article-hero__art,
  .article-hero__art img,
  .article-hero__blur {
    position: absolute;
    pointer-events: none;
  }

  .article-hero__art {
    z-index: 0;
    inset: 0;
    overflow: clip;
  }

  .article-hero__art img {
    max-width: none;
    user-select: none;
  }

  .article-hero__blur {
    z-index: 3;
    top: -150px;
    left: calc(50% - 235px);
    width: 470px;
    height: 900px;
    border-radius: 50%;
    background: #0a0b0b;
    filter: blur(100px);
    transform: rotate(100deg);
  }

  .article-hero__pattern {
    z-index: 2;
    top: -52px;
    left: -52px;
    width: calc(100% + 104px);
    height: 386.45px;
    object-fit: cover;
  }

  .article-hero__vector--top {
    z-index: 1;
    top: -282px;
    left: -152px;
    width: calc(100% + 304px);
    height: auto;
    object-fit: contain;
    filter: blur(70px);
  }

  .article-hero__vector--bottom {
    z-index: 0;
    bottom: -202px;
    left: -32px;
    width: calc(100% + 64px);
    height: 385.06px;
    object-fit: contain;
    filter: blur(100px);
    opacity: 0.3;
  }

  .article-hero__image {
    margin-top: 0;
    border-radius: 10px;
  }

  .article-copy {
    width: 100%;
    max-width: 760px;
    margin: 0 auto;
    padding: 0 30px 150px;
  }

  .article-copy .article-section + .article-section {
    margin-top: 50px;
  }

  .article-copy h2,
  .article-copy h3 {
    margin: 0;
    color: var(--ink);
    font-weight: 500;
    letter-spacing: 0;
  }

  .article-copy h2 {
    font-size: 36px;
    line-height: 1.2;
  }

  .article-copy h3 {
    font-size: 30px;
    line-height: 1.2;
  }

  .article-copy p,
  .article-copy li,
  .article-copy blockquote {
    color: rgb(84, 84, 84);
    font-size: 18px;
    line-height: 1.4;
    letter-spacing: 0;
    white-space: pre-wrap;
    overflow-wrap: break-word;
  }

  .article-copy p,
  .article-copy blockquote {
    margin: 10px 0 0;
  }

  .article-copy ul {
    margin: 10px 0 0;
    padding-left: 22.5px;
    font-size: 18px;
    line-height: 25.2px;
  }

  .article-copy li {
    padding-left: 0;
  }

  .article-copy li + li {
    margin-top: 0;
  }

  .article-copy li p {
    margin: 0;
  }

  .article-copy blockquote {
    font-style: normal;
  }

  .related {
    width: 100%;
    margin: 0;
    padding: 0 0 150px;
  }

  .related__inner {
    display: flex;
    width: min(100%, 1240px);
    flex-direction: column;
    gap: 50px;
    padding-inline: 30px;
    margin-inline: auto;
  }

  .related h2 {
    margin: 0;
    font-size: 52px;
    line-height: 1.2;
    text-wrap: balance;
  }

  .related-grid {
    display: grid;
    grid-template-columns: repeat(3, minmax(0, 1fr));
    gap: 30px;
  }

  .related-grid :global(.blog-card__meta) {
    margin-top: 16px;
    font-size: 14px;
    line-height: 1.2;
  }

  .related-grid :global(.blog-card h2) {
    max-width: none;
    margin-top: 10px;
    font-size: 22px;
    line-height: 1.4;
    font-weight: 600;
  }

  @media (max-width: 1199px) {
    .article-hero {
      padding: 79px 10px 70px;
    }

    .article-hero__stage {
      padding: 70px 10px;
    }

    .article-hero__container {
      gap: 30px;
    }

    .article-hero h1 {
      font-size: 50px;
      line-height: 1.1;
    }

    .article-hero__pattern {
      height: 232.81px;
    }

    .article-hero__vector--top {
      height: 400.75px;
    }

    .article-hero__vector--bottom {
      height: 227.72px;
    }

    .article-copy {
      padding-bottom: 120px;
    }

    .related {
      padding-bottom: 120px;
    }

    .related__inner {
      gap: 30px;
      padding-inline: 30px;
    }

    .related h2 {
      font-size: 42px;
    }

    .related-grid {
      grid-template-columns: repeat(2, minmax(0, 1fr));
    }

    .related-grid :global(.blog-card:last-child) {
      grid-column: 1 / -1;
    }

    .related-grid :global(.blog-card h2) {
      font-size: 22px;
      line-height: 1.4;
    }
  }

  @media (max-width: 809px) {
    .article-hero {
      padding: 52px 10px 70px;
    }

    .article-hero__stage {
      padding: 70px 20px;
    }

    .article-hero__container {
      gap: 20px;
    }

    .article-hero h1 {
      max-width: none;
      font-size: 40px;
      line-height: 1.1;
    }

    .article-description {
      max-width: 330px;
    }

    .article-hero__pattern {
      height: 123.44px;
    }

    .article-hero__vector--top {
      height: 246.89px;
    }

    .article-hero__vector--bottom {
      height: 115.72px;
    }

    .article-copy {
      max-width: none;
      padding: 0 20px 100px;
    }

    .article-copy h2 {
      font-size: 32px;
      line-height: 1.2;
    }

    .article-copy h3 {
      font-size: 26px;
      line-height: 1.2;
    }

    .article-copy p,
    .article-copy li,
    .article-copy blockquote {
      font-size: 18px;
      line-height: 1.4;
    }

    .article-copy blockquote {
      padding-right: 30px;
    }

    .related {
      padding-bottom: 100px;
    }

    .related__inner {
      gap: 20px;
      padding-inline: 20px;
    }

    .related h2 {
      font-size: 36px;
      line-height: 1.2;
    }

    .related-grid {
      grid-template-columns: 1fr;
      gap: 30px;
    }

    .related-grid :global(.blog-card:last-child) {
      grid-column: auto;
    }

    .related-grid :global(.blog-card h2) {
      font-size: 20px;
      line-height: 1.4;
    }
  }
</style>
