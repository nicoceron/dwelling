---
import type { BlogPost } from "../data/blog";

interface Props {
  post: BlogPost;
  featured?: boolean;
  eager?: boolean;
  hidden?: boolean;
  revealDelay?: number;
}

const { post, featured = false, eager = false, hidden = false, revealDelay } = Astro.props;
---

<a
  class="blog-card"
  class:blog-card--featured={featured}
  href={`/blog/${post.slug}`}
  data-reveal={revealDelay === undefined ? true : undefined}
  data-hero-reveal={revealDelay !== undefined ? true : undefined}
  data-delay={revealDelay}
  data-load-more-item={hidden ? true : undefined}
  hidden={hidden}
>
  <div class="blog-card__image-wrap">
    {featured && <span class="blog-card__badge">Featured Post</span>}
    <img
      class="blog-card__image"
      src={post.image}
      width="1200"
      height="660"
      alt="Blog Image"
      loading={eager ? "eager" : "lazy"}
    />
  </div>
  <div class="blog-card__meta">{post.date}</div>
  <h2>{post.title}</h2>
</a>

<style>
  .blog-card {
    display: block;
    min-width: 0;
    color: var(--ink);
  }

  .blog-card:focus-visible {
    outline: 1px auto Highlight;
    outline-offset: 1px;
  }

  .blog-card__image-wrap {
    position: relative;
    overflow: hidden;
    aspect-ratio: 1.81818;
    border-radius: 10px;
    background: var(--wash);
  }

  .blog-card__image {
    width: 100%;
    height: 100%;
    object-fit: cover;
    transition: transform 350ms cubic-bezier(0.44, 0, 0.56, 1);
  }

  .blog-card:hover .blog-card__image,
  .blog-card:focus-visible .blog-card__image {
    transform: scale(1.018);
  }

  .blog-card__badge {
    position: absolute;
    z-index: 1;
    top: 16px;
    left: 16px;
    padding: 6px 16px;
    border-radius: 10px;
    background: var(--ink);
    color: #fff;
    font-family: "Inter Display", sans-serif;
    font-size: 14px;
    font-weight: 500;
    line-height: 16.8px;
    letter-spacing: 0.3px;
  }

  .blog-card__meta {
    margin-top: 16px;
    color: rgb(84, 84, 84);
    font-family: "Inter Display", sans-serif;
    font-size: 14px;
    font-weight: 500;
    line-height: 16.8px;
    letter-spacing: 0.3px;
    white-space: pre-wrap;
    overflow-wrap: break-word;
  }

  .blog-card h2 {
    margin-top: 10px;
    font-size: 22px;
    font-weight: 600;
    line-height: 30.8px;
    letter-spacing: normal;
    text-wrap: balance;
  }

  @media (max-width: 809px) {
    .blog-card h2 {
      font-size: 20px;
      line-height: 28px;
    }
  }
</style>
