---
export interface FaqItem {
  question: string;
  answer?: string;
}

interface Props {
  items: FaqItem[];
  firstOpen?: boolean;
  single?: boolean;
  class?: string;
}

const { items, firstOpen = true, single = true, class: className = "" } = Astro.props;
const isRouteAccordion = className.split(/\s+/).includes("faq-route-list");

const slugify = (value: string) =>
  value
    .toLowerCase()
    .replace(/[^a-z0-9]+/g, "-")
    .replace(/^-|-$/g, "");
---

<div class={`faq-list ${className}`.trim()} data-accordion data-single={single ? "true" : "false"}>
  {items.map((item, index) => {
    const isOpen = firstOpen && index === 0;
    const id = `faq-${slugify(item.question)}`;
    const panelId = `${id}-answer`;

    return (
      <article class="faq-item" data-accordion-item data-accordion-index={index}>
        <h3>
          <button
            id={id}
            type="button"
            data-accordion-button
            aria-expanded={isOpen ? "true" : "false"}
            aria-controls={panelId}
          >
            <span class="faq-item__title">{item.question}</span>
            <span class={`faq-item__icon${isRouteAccordion ? "" : " faq-item__icon--text"}`} aria-hidden="true">
              {isRouteAccordion ? (
                <>
                  <span class="faq-item__divider faq-item__divider--horizontal"></span>
                  <span class="faq-item__divider faq-item__divider--vertical"></span>
                </>
              ) : (
                "+"
              )}
            </span>
          </button>
        </h3>
        <div
          id={panelId}
          class="faq-item__panel"
          data-accordion-panel
          aria-labelledby={id}
          hidden={!isOpen}
        >
          <p>{item.answer ?? ""}</p>
        </div>
      </article>
    );
  })}
</div>

<style>
  .faq-list {
    display: flex;
    width: 100%;
    flex-direction: column;
    gap: 16px;
  }

  .faq-item {
    width: 100%;
    border-bottom: 1px solid var(--line);
  }

  .faq-item h3 {
    margin: 0;
  }

  .faq-item button {
    display: flex;
    width: 100%;
    min-height: 64px;
    align-items: center;
    justify-content: space-between;
    gap: 16px;
    padding: 16px 0;
    border: 0;
    background: transparent;
    color: var(--ink);
    font: inherit;
    text-align: left;
    cursor: pointer;
  }

  .faq-item button:focus-visible {
    outline: 2px solid var(--ink);
    outline-offset: 3px;
    border-radius: 10px;
  }

  .faq-item__title {
    flex: 1;
  }

  .faq-item__icon {
    position: relative;
    display: grid;
    width: 40px;
    height: 40px;
    flex: none;
    place-items: center;
    border: 1px solid var(--line);
    border-radius: 10px;
    color: var(--ink);
    transition: background-color 350ms ease, color 350ms ease, border-color 350ms ease, transform 350ms ease;
  }

  .faq-item__icon--text {
    font-size: 20px;
    line-height: 1;
  }

  .faq-item__divider {
    position: absolute;
    top: 50%;
    left: 50%;
    display: block;
    width: 14px;
    height: 2px;
    border-radius: 3px;
    background: currentColor;
    transform: translate(-50%, -50%);
    transition: transform 350ms ease;
  }

  .faq-item__divider--vertical {
    width: 2px;
    height: 14px;
  }

  .faq-item button[aria-expanded="true"] .faq-item__icon {
    border-color: var(--ink);
    background: var(--ink);
    color: var(--paper);
    transform: rotate(45deg);
  }

  .faq-item button[aria-expanded="true"]:hover .faq-item__icon {
    background: var(--ink);
    color: var(--paper);
  }

  .faq-item__panel {
    overflow: hidden;
    padding: 0 0 18px;
  }

  .faq-item__panel p {
    max-width: 68ch;
    color: var(--muted);
    font-family: "Inter Display", sans-serif;
    font-size: 16px;
    font-weight: 500;
    line-height: 1.5;
  }

  .faq-route-list {
    gap: 20px;
  }

  .faq-route-list .faq-item {
    border-bottom: 0;
    display: flex;
    flex-direction: column;
    gap: 10px;
  }

  .faq-route-list .faq-item button {
    min-height: 46px;
    align-items: flex-start;
    gap: 10px;
    padding: 0;
  }

  .faq-route-list .faq-item__title,
  .faq-route-list .faq-item__icon {
    min-height: 46px;
    border: 1px solid rgba(10, 11, 11, 0.1);
    border-radius: 10px;
  }

  .faq-route-list .faq-item__title {
    display: flex;
    min-width: 0;
    align-items: center;
    padding: 12px 26px;
    text-wrap: balance;
    color: var(--ink);
    font-family: "Stack Sans Headline", sans-serif;
    font-size: 18px;
    font-weight: 600;
    line-height: 20px;
  }

  .faq-route-list .faq-item__icon {
    position: relative;
    display: block;
    width: 46px;
    height: 46px;
    flex: none;
    border-color: rgba(10, 11, 11, 0.1);
    background: transparent;
    color: var(--ink);
    transform: none;
    transition: none;
  }

  .faq-route-list .faq-item button .faq-item__icon {
    transform: none;
  }

  .faq-route-list .faq-item__divider {
    width: 16px;
    height: 2px;
    transform: translate(-50%, -50%);
    transition: none;
  }

  .faq-route-list .faq-item__divider--vertical {
    width: 2px;
    height: 16px;
  }

  .faq-route-list .faq-item button[aria-expanded="true"] .faq-item__title,
  .faq-route-list .faq-item button[aria-expanded="true"] .faq-item__icon {
    border-color: var(--ink);
    background: var(--ink);
    color: var(--paper);
  }

  .faq-route-list .faq-item button[aria-expanded="true"] .faq-item__divider {
    transform: translate(-50%, -50%) rotate(45deg);
  }

  .faq-route-list .faq-item button:hover .faq-item__title,
  .faq-route-list .faq-item button:hover .faq-item__icon {
    border-color: rgba(10, 11, 11, 0.1);
    background: transparent;
    color: var(--ink);
  }

  .faq-route-list .faq-item button[aria-expanded="true"]:hover .faq-item__title,
  .faq-route-list .faq-item button[aria-expanded="true"]:hover .faq-item__icon {
    border-color: var(--ink);
    background: var(--ink);
    color: var(--paper);
  }

  .faq-route-list .faq-item button:focus-visible {
    outline: 1px auto Highlight;
    outline-offset: 1px;
  }

  .faq-route-list .faq-item__panel {
    min-height: 0;
    padding: 12px 26px;
    border-radius: 10px;
    background: var(--wash);
    box-shadow: inset 0 0 0 1px rgba(10, 11, 11, 0.1);
  }

  .faq-route-list .faq-item__panel p {
    max-width: none;
    text-wrap: balance;
    color: var(--ink);
    font-family: "Inter Display", sans-serif;
    font-size: 18px;
    font-weight: 500;
    line-height: 1.4;
  }

  @media (max-width: 809px) {
    .faq-route-list .faq-item button {
      min-height: 38px;
    }

    .faq-route-list .faq-item__title,
    .faq-route-list .faq-item__icon {
      min-height: 38px;
    }

    .faq-route-list .faq-item__title {
      padding: 8px 16px;
      font-size: 16px;
      line-height: 1.2;
    }

    .faq-route-list .faq-item__icon {
      width: 38px;
      height: 38px;
    }

    .faq-route-list .faq-item__panel {
      padding: 8px 16px;
    }

    /* Preserve the measured per-instance wrapped-row states from Framer. */
    .faq-route-group--1 .faq-item[data-accordion-index="2"] .faq-item__title,
    .faq-route-group--1 .faq-item[data-accordion-index="3"] .faq-item__title {
      min-height: 58.45px;
    }

    .faq-route-group--2 .faq-item[data-accordion-index="0"] .faq-item__title,
    .faq-route-group--2 .faq-item[data-accordion-index="3"] .faq-item__title,
    .faq-route-group--3 .faq-item[data-accordion-index="0"] .faq-item__title,
    .faq-route-group--3 .faq-item[data-accordion-index="1"] .faq-item__title,
    .faq-route-group--4 .faq-item[data-accordion-index="1"] .faq-item__title,
    .faq-route-group--4 .faq-item[data-accordion-index="2"] .faq-item__title,
    .faq-route-group--4 .faq-item[data-accordion-index="3"] .faq-item__title {
      border: 0;
      box-shadow: inset 0 0 0 1px rgba(10, 11, 11, 0.1);
    }
  }
</style>
