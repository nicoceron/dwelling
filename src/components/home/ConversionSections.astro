---

<section id="ai-automation" class="conversion-section ai-section" data-reveal data-reveal-each>
  <div class="ai-section__shell" data-reveal-child>
    <img class="ai-section__background ai-section__background--side ai-section__background--side-left" src="/assets/framerusercontent.com/images/Z2UDtbk8bfIZAqJe8uLUYDVxFI.svg" alt="" aria-hidden="true" />
    <img class="ai-section__background ai-section__background--side ai-section__background--side-right" src="/assets/framerusercontent.com/images/Z2UDtbk8bfIZAqJe8uLUYDVxFI.svg" alt="" aria-hidden="true" />
    <img class="ai-section__background ai-section__background--grid" src="/assets/framerusercontent.com/images/IaNCr2d8JUTUZ2bOx135NYqB2wQ.svg" alt="" aria-hidden="true" />
    <img class="ai-section__background ai-section__background--glow" src="/assets/framerusercontent.com/images/9APaz5YMgQECkE1T48f88rrLqA.svg" alt="" aria-hidden="true" />
    <img class="ai-section__background ai-section__background--base" src="/assets/framerusercontent.com/images/kDa223DGZcZDfotnhFbOWGrSUx0.svg" alt="" aria-hidden="true" />
    <div class="ai-section__content">
      <div class="ai-section__top" aria-hidden="true" data-reveal-child>
        <div class="ai-section__box"><div class="ai-section__robot"><img src="/assets/framerusercontent.com/images/gxhmwKSyGP38onndZH9QGqvuAY.svg" alt="" /></div></div>
        <img class="ai-section__top-dots" src="/assets/framerusercontent.com/images/E99eulpVBc1ySQXhWIUL0ECVcI.svg" alt="" />
      </div>
      <div class="ai-section__heading" data-reveal-child>
        <p class="eyebrow ai-section__eyebrow"><span>Beta</span> AI Automation</p>
        <h2 class="display-lg ai-section__title">AI automation that removes busywork</h2>
        <p class="copy-lg ai-section__intro">Skip the busywork. Tasks, summaries, and follow-ups happen automatically.</p>
      </div>

      <div class="ai-tabs" data-tabs data-reveal-child>
        <div class="ai-tabs__list" role="tablist" aria-label="AI automation features">
          {aiTabs.map((tab, index) => (
            <button
              type="button"
              role="tab"
              id={`ai-tab-${tab.id}`}
              aria-controls={`ai-panel-${tab.id}`}
              aria-selected={index === 0 ? "true" : "false"}
              tabindex={index === 0 ? "0" : "-1"}
              data-tab={tab.id}
            >{tab.label}</button>
          ))}
        </div>

        <div class="ai-tabs__panels">
          {aiTabs.map((tab, index) => (
            <div
              class="ai-panel"
              id={`ai-panel-${tab.id}`}
              role="tabpanel"
              aria-labelledby={`ai-tab-${tab.id}`}
              tabindex="0"
              data-tab-panel={tab.id}
              hidden={index !== 0}
            >
              <div class="ai-panel__copy">
                <h3 data-tab-stage="0">{tab.title}</h3>
                <p data-tab-stage="1">{tab.body}</p>
                <p class="eyebrow" data-tab-stage="2">Benefits</p>
                <ul data-tab-stage="3">
                  {tab.benefits.map((benefit) => <li>{benefit}</li>)}
                </ul>
              </div>
              <div class="ai-panel__visual" aria-hidden="true" data-tab-stage="4">
                <img src={tab.image} alt="" />
                <span class="ai-panel__glow"></span>
              </div>
            </div>
          ))}
        </div>
      </div>

      <Button href="/waitlist" variant="light" data-reveal-child>Join the waitlist</Button>
    </div>
  </div>
</section>

<section class="conversion-section stats-section" data-reveal>
  <div class="conversion-container stats-section__inner">
    <div class="stats-section__heading" data-reveal-child>
      <h2 class="display-sm">What teams achieve with our platform</h2>
      <Button href="/contact" variant="dark">Get started - it’s free</Button>
    </div>
    <div class="stats-grid">
      {stats.map((stat) => (
        <article class="stat-card" data-reveal-child>
          <div class="stat-card__icon"><img src={stat.icon} alt="" aria-hidden="true" /></div>
          <p class="stat-card__value" data-rolling-counter>{stat.value}</p>
          <h3>{stat.title}</h3>
          <p>{stat.body}</p>
        </article>
      ))}
    </div>
  </div>
</section>

<section id="use-case" class="conversion-section use-case-section" data-reveal>
  <div class="conversion-container use-case-section__grid">
    <div class="use-case-section__copy" data-reveal-child>
      <p class="eyebrow">Built for teams</p>
      <h2 class="display-lg">One system that fits many roles</h2>
      <p class="copy-lg">Different teams use the platform in different ways, but the goal stays the same: keep work, clients, and revenue in one simple place.</p>
      <div class="use-case-list" aria-label="Teams that use Worklane" data-use-case-list>
        {useCases.map((item) => <span>{item}</span>)}
        {moreUseCases.map((item, index) => <span class="use-case-list__extra" style={`--use-case-delay: ${index * 35}ms`} hidden>{item}</span>)}
        <button class="use-case-list__more" type="button" aria-expanded="false" data-use-case-toggle>More+</button>
      </div>
    </div>
      <div class="use-case-section__art" data-reveal-child>
        <div class="use-case-section__art-inner">
          <div class="use-case-section__dashboard-row">
            <img class="use-case-section__dashboard" src="/assets/framerusercontent.com/images/L2721AQXYgSsOa6eSNqJe0DvWeo.svg" alt="" aria-hidden="true" />
            <img class="use-case-section__dashboard-small" src="/assets/framerusercontent.com/images/WT1Jjv0thrDq97YNRcbo47OTyE.svg" alt="" aria-hidden="true" />
          </div>
          <img class="use-case-section__activity" src="/assets/framerusercontent.com/images/od6YB0Is1yHFd6Wnm27gtEjqE.jpg" alt="" aria-hidden="true" />
        </div>
      </div>
  </div>
</section>

<section id="pricing" class="conversion-section pricing-section" data-reveal>
  <div class="conversion-container pricing-section__inner" data-tabs>
    <div class="pricing-section__heading" data-reveal-child>
      <p class="eyebrow">Pricing</p>
      <h2 class="display-lg">Simple pricing that grows with your team</h2>
    </div>
    <div class="pricing-switcher">
      <div class="pricing-switcher__tabs" role="tablist" aria-label="Pricing period">
        <button type="button" role="tab" id="pricing-tab-monthly" aria-controls="pricing-panel-monthly" aria-selected="true" tabindex="0" data-tab="monthly">Monthly</button>
        <button type="button" role="tab" id="pricing-tab-yearly" aria-controls="pricing-panel-yearly" aria-selected="false" tabindex="-1" data-tab="yearly">Yearly <span>20% Off</span></button>
      </div>
    </div>

    <div class="pricing-panels">
      <div id="pricing-panel-monthly" class="pricing-grid" role="tabpanel" aria-labelledby="pricing-tab-monthly" data-tab-panel="monthly">
        {plans.map((plan) => (
          <article class:list={["plan-card", plan.popular && "plan-card--popular"]} data-reveal-child>
            <div class="plan-card__topline"><span class="plan-card__symbol" aria-hidden="true"><img src={plan.icon} alt="" /></span>{plan.popular && <span>Most popular</span>}</div>
            <h3>{plan.name}</h3>
            <p class="plan-card__summary">{plan.summary}</p>
            <p class="plan-card__price"><strong>{plan.monthly}</strong><span>/month</span></p>
            <Button href="/contact" variant={plan.popular ? "light" : "dark"} showIcon={false}>{plan.cta}</Button>
            <ul>{plan.features.map((feature) => <li>{feature}</li>)}</ul>
          </article>
        ))}
      </div>

      <div id="pricing-panel-yearly" class="pricing-grid" role="tabpanel" aria-labelledby="pricing-tab-yearly" data-tab-panel="yearly" hidden>
        {plans.map((plan) => (
          <article class:list={["plan-card", plan.popular && "plan-card--popular"]}>
            <div class="plan-card__topline"><span class="plan-card__symbol" aria-hidden="true"><img src={plan.icon} alt="" /></span>{plan.popular && <span>Most popular</span>}</div>
            <h3>{plan.name}</h3>
            <p class="plan-card__summary">{plan.summary}</p>
            <p class="plan-card__price"><strong>{plan.yearly}</strong><span>/month</span></p>
            <Button href="/contact" variant={plan.popular ? "light" : "dark"} showIcon={false}>{plan.cta}</Button>
            <ul>{plan.features.map((feature) => <li>{feature}</li>)}</ul>
          </article>
        ))}
      </div>
    </div>
  </div>
</section>

<section id="reviews" class="conversion-section reviews-section" data-reveal>
  <div class="reviews-section__shell conversion-container">
    <div class="reviews-section__inner">
      <div class="reviews-section__heading" data-reveal-child>
        <div>
          <p class="eyebrow">What teams say</p>
          <h2 class="display-lg">Trusted by teams who run real work</h2>
        </div>
        <div class="reviews-section__rating" aria-label="4.8 out of 5 stars">
          <strong>4.8</strong>
          <img src="/assets/framerusercontent.com/images/mjeLsRjb36YORRtjdHC2ntKRhD0.svg" alt="5 stars" />
          <small>Review by 356 users worldwide</small>
        </div>
      </div>

      <div class="reviews-viewport" data-review-viewport role="region" aria-label="Customer reviews" tabindex="0">
        <div class="reviews-grid" data-review-track>
          {[...reviews, ...reviews].map((review, index) => (
            <article class:list={["review-card", review.visual && "review-card--visual", index >= reviews.length && "review-card--clone"]} data-reveal-child={index < reviews.length ? true : undefined} aria-hidden={index >= reviews.length ? "true" : undefined}>
              {review.visual && <img class="review-card__photo" src={review.image} alt="" aria-hidden="true" />}
              <div class="review-card__content">
                <div class="review-card__person">
                  {!review.visual && <img src={review.image} alt={`${review.name} avatar`} />}
                  <div><h3>{review.name}</h3><p>{review.role}</p></div>
                </div>
                <blockquote>“{review.quote}”</blockquote>
              </div>
            </article>
          ))}
        </div>
      </div>
    </div>
  </div>
</section>

<section class="conversion-section faq-preview-section" data-reveal>
  <div class="conversion-container faq-preview-section__grid">
    <div class="faq-preview-section__copy" data-reveal-child>
      <p class="eyebrow">FAQs</p>
      <h2 class="display-lg">Answers to common questions</h2>
      <div class="faq-preview-section__cta">
        <h3>Can’t find your answer?</h3>
        <Button href="/contact" variant="dark">Talk to us</Button>
      </div>
    </div>
    <FaqAccordion items={faqItems} firstOpen={true} single={false} class="faq-route-list faq-preview-section__list" />
  </div>
</section>

<script>
  const useCaseList = document.querySelector<HTMLElement>("[data-use-case-list]");
  const useCaseToggle = useCaseList?.querySelector<HTMLButtonElement>("[data-use-case-toggle]");
  if (useCaseList && useCaseToggle) {
    const extraUseCases = useCaseList.querySelectorAll<HTMLElement>(".use-case-list__extra");
    useCaseToggle.addEventListener("click", () => {
      const expanded = useCaseToggle.getAttribute("aria-expanded") !== "true";
      useCaseToggle.setAttribute("aria-expanded", String(expanded));
      useCaseToggle.textContent = expanded ? "Less-" : "More+";
      if (expanded) useCaseList.setAttribute("data-expanded", "");
      else useCaseList.removeAttribute("data-expanded");
      extraUseCases.forEach((item) => { item.hidden = !expanded; });
    });
  }

  const reviewViewport = document.querySelector<HTMLElement>("[data-review-viewport]");
  const reviewTrack = reviewViewport?.querySelector<HTMLElement>("[data-review-track]");

  if (reviewViewport && reviewTrack) {
    const cards = Array.from(reviewTrack.children) as HTMLElement[];
    const reducedMotion = window.matchMedia("(prefers-reduced-motion: reduce)");
    const mobile = window.matchMedia("(max-width: 809px)");
    let cycleWidth = 0;
    let offset = 0;
    let previousTime = performance.now();
    let pointerId: number | null = null;
    let pointerX = 0;
    let visible = false;

    const measure = () => {
      cycleWidth = cards.length >= 10 ? cards[5].offsetLeft - cards[0].offsetLeft : 0;
      if (mobile.matches) {
        offset = 0;
        reviewTrack.style.removeProperty("transform");
      }
    };
    const normalize = (value: number) => {
      if (!cycleWidth) return 0;
      const wrapped = ((value % cycleWidth) + cycleWidth) % cycleWidth;
      return wrapped > 0 ? wrapped - cycleWidth : 0;
    };
    const draw = () => {
      if (!mobile.matches) reviewTrack.style.transform = `translateX(${offset}px)`;
    };

    // The source strip repeats its five cards and supports horizontal drag.
    reviewTrack.style.animation = "none";
    measure();
    window.addEventListener("resize", measure, { passive: true });
    const visibilityObserver = new IntersectionObserver(([entry]) => {
      visible = entry.isIntersecting;
    });
    visibilityObserver.observe(reviewViewport);

    reviewViewport.addEventListener("pointerdown", (event) => {
      if (mobile.matches || (event.pointerType === "mouse" && event.button !== 0)) return;
      pointerId = event.pointerId;
      pointerX = event.clientX;
      reviewViewport.setPointerCapture(event.pointerId);
      reviewViewport.dataset.dragging = "";
    });
    reviewViewport.addEventListener("pointermove", (event) => {
      if (pointerId !== event.pointerId || mobile.matches) return;
      offset = normalize(offset + event.clientX - pointerX);
      pointerX = event.clientX;
      draw();
    });
    const finishDrag = (event: PointerEvent) => {
      if (pointerId !== event.pointerId) return;
      pointerId = null;
      reviewViewport.removeAttribute("data-dragging");
      if (reviewViewport.hasPointerCapture(event.pointerId)) reviewViewport.releasePointerCapture(event.pointerId);
    };
    reviewViewport.addEventListener("pointerup", finishDrag);
    reviewViewport.addEventListener("pointercancel", finishDrag);
    reviewViewport.addEventListener("keydown", (event) => {
      if (mobile.matches || !["ArrowLeft", "ArrowRight"].includes(event.key)) return;
      event.preventDefault();
      offset = normalize(offset + (event.key === "ArrowRight" ? -200 : 200));
      draw();
    });

    const advance = (time: number) => {
      const elapsed = Math.min(time - previousTime, 100);
      previousTime = time;
      if (visible && !mobile.matches && !reducedMotion.matches && pointerId === null &&
          document.visibilityState === "visible") {
        offset = normalize(offset - elapsed * 0.02);
        draw();
      }
      requestAnimationFrame(advance);
    };
    requestAnimationFrame(advance);
  }
</script>

<style>
  .conversion-section { position: relative; overflow: hidden; }
  .conversion-container { width: min(100%, 1180px); margin: 0 auto; }
  .ai-section, .reviews-section { padding: 150px 30px; }
  .ai-section__shell { position: relative; min-height: 1455px; overflow: hidden; border-radius: 20px; background: radial-gradient(circle at 50% 42%, rgba(103, 76, 208, .4), transparent 34%), radial-gradient(circle at 20% 75%, rgba(23, 116, 222, .22), transparent 28%), #090a0c; color: #fff; }
  .ai-section__content { position: relative; z-index: 1; display: flex; flex-direction: column; align-items: center; padding-top: 78px; text-align: center; }
  .ai-section__pattern { position: absolute; top: 80px; left: 0; width: 270px; opacity: .5; }
  .ai-section__dots { position: absolute; right: 6%; bottom: 14%; width: 160px; opacity: .4; }
  .ai-section__eyebrow span { display: inline-flex; margin-right: 8px; padding: 4px 8px; border: 1px solid rgba(255,255,255,.24); border-radius: 999px; color: #c3b7ff; font-size: 11px; }
  .ai-section__title { max-width: 720px; margin: 18px auto 0; }
  .ai-section__intro { max-width: 570px; margin: 18px auto 0; color: rgba(255,255,255,.68); }
  .ai-tabs { width: min(100%, 980px); margin-top: 74px; }
  .ai-tabs__list, .pricing-switcher__tabs { display: inline-flex; align-items: center; gap: 4px; padding: 5px; border: 1px solid rgba(255,255,255,.14); border-radius: 12px; background: rgba(255,255,255,.06); }
  .ai-tabs__list button, .pricing-switcher__tabs button { border: 0; border-radius: 8px; background: transparent; color: rgba(255,255,255,.62); cursor: pointer; font: inherit; font-size: 14px; padding: 12px 18px; transition: background-color 450ms cubic-bezier(.44,0,.56,1), color 450ms cubic-bezier(.44,0,.56,1), transform 450ms cubic-bezier(.44,0,.56,1); }
  .ai-tabs__list button:hover, .ai-tabs__list button:focus-visible { color: #fff; transform: translateY(-1px); }
  .ai-tabs__list button[aria-selected="true"], .pricing-switcher__tabs button[aria-selected="true"] { background: #fff; color: var(--ink); }
  .ai-tabs__panels { margin-top: 34px; }
  .ai-panel { display: grid; min-height: 590px; grid-template-columns: .9fr 1.1fr; align-items: center; gap: 44px; padding: 48px; border: 1px solid rgba(255,255,255,.13); border-radius: 20px; background: linear-gradient(135deg, rgba(255,255,255,.1), rgba(255,255,255,.035)); text-align: left; }
  .ai-panel__copy h3 { max-width: 410px; margin: 16px 0; font-size: clamp(30px, 3.2vw, 52px); letter-spacing: -.04em; line-height: 1; }
  .ai-panel__copy > p:not(.eyebrow) { max-width: 420px; color: rgba(255,255,255,.7); }
