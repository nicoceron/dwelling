    id: "auto-tasks",
    label: "Auto-tasks",
    title: "Auto-create tasks",
    body: "Your AI converts raw notes, client messages, or long updates into structured tasks with owners, deadlines, and priority — without you typing a single line.",
    image: "/assets/framerusercontent.com/images/GquWECjBgqNlQMEuc3LTpc4ulA.png",
    benefits: [
      "Breaks big updates into actionable tasks",
      "Assigns owners automatically if the context is clear",
      "Sets deadlines based on upcoming milestones",
    ],
  },
  {
    id: "follow-ups",
    label: "Follow-ups",
    title: "Auto-follow-ups",
    body: "Your AI schedules and sends reminders, invoice nudges, and overdue follow-ups automatically, based on rules you control.",
    image: "/assets/framerusercontent.com/images/NoiucdwvdxxL1h0tOOCj7SlA.png",
    benefits: [
      "Sends reminders at the right time",
      "Tracks overdue invoices and due dates",
      "Keeps clients moving without manual effort",
    ],
  },
  {
    id: "priority",
    label: "Priority",
    title: "Auto-prioritization",
    body: "Your AI ranks tasks and clients based on urgency, value, deadlines, and workload, so your team always tackles the highest-impact items first.",
    image: "/assets/framerusercontent.com/images/kYTzbNVh5LBvxpai5H82hoW0kWQ.png",
    benefits: [
      "Flags urgent deadlines and risks",
      "Highlights high-value clients needing attention",
      "Balances workload across team members",
    ],
  },
  {
    id: "summaries",
    label: "Summaries",
    title: "Auto-summaries",
    body: "Instead of reading long chat threads or call notes, your AI writes a concise summary with the key decisions, blockers, and action items.",
    image: "/assets/framerusercontent.com/images/CGhsmA06gaviXj0BzRaVxiJ6DPQ.png",
    benefits: [
      "Pulls the important details",
      "Removes filler and irrelevant back-and-forth",
      "Gives you an instant understanding of next steps",
    ],
  },
];

const stats = [
  { value: "50%", title: "Faster workflows", body: "Reduce manual work and speed execution.", icon: "/assets/framerusercontent.com/images/nmqSHiEGYBvrpbGNoN3hjGOqLq8.svg" },
  { value: "10+", title: "Tools connected", body: "Connect your tools and workflows easily.", icon: "/assets/framerusercontent.com/images/Tqi7i7LV6QHLgIvBwTjF91p9tw.svg" },
  { value: "99%", title: "Platform reliability", body: "Dependable performance you can rely on.", icon: "/assets/framerusercontent.com/images/OwsfyxWgXqaMwkP1giWy4YXzRc.svg" },
];

const useCases = ["Agencies", "Consultants", "Startups", "Freelancers", "Service teams", "Product teams"];
const moreUseCases = ["Customer support", "Design teams", "Sales teams", "IT support", "Marketing teams", "Customer success", "Finance teams"];

const plans = [
  {
    name: "Starter plan",
    summary: "Best for very small teams",
    monthly: "$19",
    yearly: "$15",
