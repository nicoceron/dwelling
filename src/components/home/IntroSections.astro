---
import Button from "../Button.astro";

const assetRoot = "/assets/framerusercontent.com/images/";

const logos = [
  "1V1LJixKLDvrxh8xOoZbrIVvCI.svg",
  "oRN2uzufZi3DeitkcAnHnWgN18M.svg",
  "XHQ3C2x8n6FxPNFotbBGxYoXyPk.svg",
  "htiHsU4ECQNNvBhtKRtPdaWCxhI.svg",
  "H2xCDaX7cGo1G5Bzx8nkkIhDNY.svg",
  "fWlNTIHBRiUW4WfvrDUFrCApUU.svg",
  "1LhjPHRS5aDykP9rN1qLssbZ2W4.svg",
  "RIHN1KQzftKkt5zj1YxEM8Yf9NY.svg",
  "FapjXnOUprkUxWJ9o8skAlFA.svg",
];

const featureCards = [
  {
    cycle: "task-stack",
    images: [
      "svUNpKsuZUyE6StqWgh8U9rf6qU.jpg",
      "x1AMDEB94PtJdVAVkZpIgmjEfEA.jpg",
      "zOMEU8dK3S5ImO9XqYF6eRtfMko.jpg",
    ],
    title: "Stay on top of work",
    description: "Track tasks, deadlines, and owners without jumping between tools.",
    tone: "purple",
    imageWidth: 620,
    imageHeight: 211,
    icons: [
      "AvrQKIDP4gqsWZdPVuSG1T8yZp8.svg",
      "9MXr6kwUQwGiLjfMF2FLR0VjSA.svg",
      "Naz4jhaQB7mUV0fNg94ikhsYcQ.svg",
      "i3z2EfLyKPZcUNfsQ7MBtMAnBA.svg",
      "0ArguFIuHqvD3HbpJ33SCpJ9k.svg",
    ],
  },
  {
    cycle: "client-list",
    images: [
      "nSe8blbCvPcYhQveWxm0NJHIY.jpg",
      "voAwwF9yTJjWncGrWBL32V2a4Q.jpg",
      "sbpSCkzyDD59C3iZEYpiTYQLqI.jpg",
      "B3FZ6kLOVZ2frGl1u0rGDCOPXB0.jpg",
      "tf1NQa1sBT2Ye16bFRE36oYxJg.jpg",
      "nSe8blbCvPcYhQveWxm0NJHIY.jpg",
    ],
    title: "Keep clients organized",
    description: "See notes, updates, and status in one place so your team stays aligned.",
    tone: "pink",
    imageWidth: 520,
    imageHeight: 255,
    icons: [
      "AvrQKIDP4gqsWZdPVuSG1T8yZp8.svg",
      "9MXr6kwUQwGiLjfMF2FLR0VjSA.svg",
      "Naz4jhaQB7mUV0fNg94ikhsYcQ.svg",
      "i3z2EfLyKPZcUNfsQ7MBtMAnBA.svg",
      "0ArguFIuHqvD3HbpJ33SCpJ9k.svg",
    ],
  },
];

const clientStates = [
  "s9Wi1haO1QyrGiENzC4NZm2RuxA.svg",
  "XAV8zvZ28TtJQBAVl6CwCGFmWxw.svg",
  "xHh41bEkh3xA5ICVrWbQK3yVU.svg",
  "s9Wi1haO1QyrGiENzC4NZm2RuxA.svg",
];

const clientIcons = [
  "i3z2EfLyKPZcUNfsQ7MBtMAnBA.svg",
  "9MXr6kwUQwGiLjfMF2FLR0VjSA.svg",
  "0ArguFIuHqvD3HbpJ33SCpJ9k.svg",
  "i3z2EfLyKPZcUNfsQ7MBtMAnBA.svg",
  "9MXr6kwUQwGiLjfMF2FLR0VjSA.svg",
  "0ArguFIuHqvD3HbpJ33SCpJ9k.svg",
  "i3z2EfLyKPZcUNfsQ7MBtMAnBA.svg",
  "9MXr6kwUQwGiLjfMF2FLR0VjSA.svg",
];

const setupSteps = [
  ["01", "Create your workspace", "Add your company details, set up projects, and import your existing clients."],
  ["02", "Invite your team", "Add teammates, manage permissions, and work as one team."],
  ["03", "Track work and revenue", "Assign roles, share workloads, and let everyone manage their own tasks."],
];

const highlightCards = [
  ["VNNG46Ii7aeHLnTbXoOQI4lt5Hg.svg", "Clean daily views", "See what matters today without digging into tasks."],
  ["zHt8Ahwn2No9nXDb3VhLjOugMU.svg", "Real-time overview", "Catch delays and workload issues before they grow."],
  ["WsYt1lj1WP2zk3MdJh1qxx6Mg.svg", "Clear client activity", "Track client updates and progress at a glance."],
  ["mjkoBtPeo7MGybZv6VnHgYT64do.svg", "Work and revenue", "See how work and invoices connect."],
];

const teamMembers = [
  { name: "Sarah Chen", tasks: "12 Task", progress: "89%", avatar: "hYfCvJ3IVdEznEOwIQiiAxWOsPY.jpg" },
  { name: "Emma Davis", tasks: "15 Task", progress: "95%", avatar: "Wu0ngxjedkJ31EstGJABQBoafk.jpg" },
  { name: "Mike Johnson", tasks: "8 Task", progress: "60%", avatar: "X0ECJ5xGgYrCVgHB8RYd3RABTQ.jpg" },
  { name: "Grace Thompson", tasks: "10 Task", progress: "79%", avatar: "5O8P63EQwkFO1m5OTR4jsw7hI8.jpg" },
];
---

<div class="intro-sections">
  <section class="hero" id="hero" data-hero-root>
    <div class="hero__stage">
      <video class="hero__video" autoplay muted loop playsinline poster={`${assetRoot}pq19iENddsKI2MmE03hZndM6Eb0.jpg`} aria-hidden="true">
        <source src="/assets/framerusercontent.com/assets/lnAIyCSC1WL1TmpzrvjMZIME0.mp4" type="video/mp4" />
      </video>
      <div class="hero__glow" aria-hidden="true"></div>
      <div class="hero__copy">
        <div class="hero__eyebrow"><span data-hero-reveal data-delay="100" data-hero-y="20">New</span><span data-hero-reveal data-delay="250" data-hero-y="20">Smarter workflow management</span></div>
        <h1 class="hero__title-desktop" data-hero-reveal data-delay="350" data-hero-y="20">
          <span class="hero__line">Take control of your</span>
          <span class="hero__line">daily <span class="hero__rotator hero__rotator--desktop" aria-label="Workflows">
            <span class="hero__rotator-track"><span>Workflows</span><span>Operations</span><span>Processes</span><span>Execution</span><span aria-hidden="true">Workflows</span></span>
          </span>
          </span>
          <span class="hero__rotator hero__rotator--mobile" aria-label="Workflows">
            <span class="hero__rotator-track"><span>Workflows</span><span>Operations</span><span>Processes</span><span>Execution</span><span aria-hidden="true">Workflows</span></span>
          </span>
        </h1>
        <h1 class="hero__title-compact" aria-label="Take control of your daily Workflows" data-hero-reveal data-delay="350" data-hero-y="20">
          <span class="hero__compact-line">Take</span><span class="hero__compact-line">control</span><span class="hero__compact-line">of</span><span class="hero__compact-line">your</span><span class="hero__compact-line">daily</span>
          <span class="hero__rotator hero__rotator--mobile" aria-hidden="true">
            <span class="hero__rotator-track"><span>Workflows</span><span>Operations</span><span>Processes</span><span>Execution</span><span aria-hidden="true">Workflows</span></span>
          </span>
        </h1>
        <p data-hero-reveal data-delay="450" data-hero-y="20">Stop juggling tools. Keep work, clients, and cash flow in one place so your team always knows what to do next.</p>
        <div class="hero__actions" data-hero-reveal data-delay="550" data-hero-y="20">
          <Button href="/contact" variant="light">Start free trial</Button>
          <button class="hero__watch" type="button" data-demo-open>
            <span class="hero__watch-icon" aria-hidden="true"><span><img src={`${assetRoot}tS0ZuZlJiNpvPvkALsbfBb1Eig.svg`} alt="" /></span><span><img src={`${assetRoot}tS0ZuZlJiNpvPvkALsbfBb1Eig.svg`} alt="" /></span></span>
            <span class="hero__watch-label"><span>Watch demo</span><span aria-hidden="true">Watch demo</span></span>
          </button>
        </div>
        <small data-hero-reveal data-delay="550" data-hero-y="20">Free for 14 days. No card required.</small>
        <div class="hero__stats">
          <div data-hero-reveal data-delay="650" data-hero-y="20"><strong><img src={`${assetRoot}Dy83TT1gYQIAXFdm55QGwjGBI3o.svg`} alt="" /><span class="hero__rating">4.8<small>/5.0</small></span></strong><span>Reviews by 356 users worldwide</span></div>
          <div data-hero-reveal data-delay="800" data-hero-y="20"><strong><img src={`${assetRoot}U2vPQ3OJzsjg6UDR1fOIawniOk.svg`} alt="" /><span class="hero__counter" data-rolling-counter data-counter-delay="800">30+</span></strong><span>Running businesses across countries</span></div>
        </div>
      </div>
      <div class="hero__art" data-hero-reveal data-delay="850" data-hero-y="50">
        <img data-hero-dashboard data-delay="1000" data-scroll-parallax data-scroll-from="50" data-scroll-to="-50" data-scroll-threshold="0" src={`${assetRoot}ax73Pu3tEPWHdz4xmX8C4BIcCzY.png`} alt="Worklane workflow dashboard" width="2880" height="2060" />
      </div>
    </div>
    <dialog class="demo-dialog" data-demo-dialog aria-label="Worklane demo video">
      <div class="demo-dialog__player">
        <iframe
          title="Worklane demo video"
          data-demo-player
          data-src="https://www.youtube.com/embed/b-jRHsYdomY?v=b-jRHsYdomY&feature=youtu.be&iv_load_policy=3&rel=0&modestbranding=1&playsinline=1&autoplay=1&mute=1"
          allow="autoplay; encrypted-media; fullscreen; picture-in-picture"
          allowfullscreen
        ></iframe>
      </div>
      <button class="demo-dialog__close" type="button" data-demo-close aria-label="Close demo" autofocus></button>
    </dialog>
    <div class="hero__logos" data-hero-reveal data-delay="1100" data-hero-y="20">
      <strong>Trusted by<br />teams worldwide</strong>
      <div class="hero__logo-window"><div class="hero__logo-track">
        {logos.map((logo) => <img src={`${assetRoot}${logo}`} alt="" width="92" height="20" />)}
        {logos.map((logo) => <img src={`${assetRoot}${logo}`} alt="" width="92" height="20" aria-hidden="true" />)}
      </div></div>
    </div>
  </section>

  <section class="features section-shell" id="features" data-reveal data-reveal-each>
    <div class="section-heading">
      <span class="section-kicker" data-reveal-child data-reveal-delay="100">What you get</span>
      <h2 data-reveal-child data-reveal-delay="200">Everything you need in one place</h2>
    </div>
    <div class="feature-grid">
      {featureCards.map((card, index) => (
        <article class={`feature-card feature-card--${card.tone}`} data-cycle-card data-cycle-index="0" data-reveal-child data-reveal-delay={String(300 + index * 100)}>
          <div
            class="feature-card__visual"
            data-feature-cycle={card.cycle}
            data-cycle-index="0"
            data-source-component={card.cycle === "task-stack" ? "Feature Card 01" : "Feature Card 02"}
            data-source-variant="Default"
          >
            {card.cycle === "task-stack" ? (
              <div class="task-stack" aria-label="Task status examples">
                {card.images.map((image, index) => (
                  <img
                    class="task-stack__item"
                    src={`${assetRoot}${image}`}
                    alt=""
                    width={card.imageWidth}
                    height={card.imageHeight}
                    aria-hidden="true"
                    data-cycle-item
                    data-cycle-slot={index}
                  />
                ))}
              </div>
            ) : (
              <div class="client-list-cycle" aria-hidden="true">
                <div class="client-list-cycle__icons">
                  <div class="client-list-cycle__track">
                    {[...card.icons, ...card.icons].map((icon, index) => (
                      <span class:list={["client-list-cycle__icon", index === 2 && "is-active"]} data-cycle-item>
                        <img src={`${assetRoot}${icon}`} alt="" />
                      </span>
                    ))}
                  </div>
                </div>
                {card.images.map((image, index) => (
                  <img
                    class:list={["client-list-cycle__panel", index === 0 && "is-active"]}
                    src={`${assetRoot}${image}`}
                    alt=""
                    width={card.imageWidth}
                    height={card.imageHeight}
                    aria-hidden={index === 0 ? "false" : "true"}
                    data-cycle-panel
                  />
                ))}
              </div>
            )}
          </div>
          <div class="feature-card__body feature-card__body--plain">
            <div><h3>{card.title}</h3><p>{card.description}</p></div>
          </div>
        </article>
      ))}
      <article class="feature-card feature-card--revenue" data-reveal-child data-reveal-delay="500">
        <div class="revenue-card__top">
          <div class="revenue-card__copy"><span>Revenue this month</span><div class="revenue-card__amount"><strong>$142.5K</strong><small>Total revenue</small></div></div>
          <div class="ring" data-progress-ring data-progress="75" style="--ring-offset: 70.6858"><svg viewBox="0 0 100 100" aria-hidden="true"><circle cx="50" cy="50" r="45" fill="none" stroke-width="10" stroke-linecap="round" /></svg><b>75%</b></div>
        </div>
        <div class="feature-card__body"><div class="mini-icon mini-icon--green"><img src={`${assetRoot}Naz4jhaQB7mUV0fNg94ikhsYcQ.svg`} alt="" /></div><div><h3>Understand your numbers</h3><p>View revenue, overdue payments, invoices, and expenses.</p></div></div>
      </article>
    </div>
  </section>

  <section class="setup section-shell" data-reveal data-reveal-each>
    <div class="setup__visual dark-stage" data-reveal-child>
      <div class="setup__glow setup__glow--top" aria-hidden="true"></div>
      <div class="setup__glow setup__glow--bottom" aria-hidden="true"></div>
      <img class="setup__pattern setup__pattern--top" src={`${assetRoot}DR9RuTqYcKJVZ75ladALY19SLmg.svg`} alt="" aria-hidden="true" />
      <img class="setup__pattern setup__pattern--bottom" src={`${assetRoot}DR9RuTqYcKJVZ75ladALY19SLmg.svg`} alt="" aria-hidden="true" />
      <div class="setup__orbit-layer" aria-hidden="true">
        <div class="setup__orbit setup__orbit--one"><img src={`${assetRoot}F9y3GRGUZTfgjOd6jU7QOZ5GaAQ.svg`} alt="" /></div>
        <div class="setup__orbit setup__orbit--two"><img src={`${assetRoot}vAztMktWVBgi9xRggoGElspL84.svg`} alt="" /></div>
        <div class="setup__orbit setup__orbit--three"><img src={`${assetRoot}Hv5onqxVxvDsRZWgTQ3nBi2ZU.svg`} alt="" /></div>
        <div class="setup__orbit setup__orbit--four"><img src={`${assetRoot}uRSK3SjceexcUJAx1sBagiFhvd4.svg`} alt="" /></div>
        <div class="setup__orbit setup__orbit--five"><img src={`${assetRoot}bLqM9csK2ivj7NObOqaMq18nvc.svg`} alt="" /></div>
        <div class="setup__orbit setup__orbit--six"><img src={`${assetRoot}hdoyt0M5jMx1NbPV38aUT2cylNs.svg`} alt="" /></div>
        <div class="setup__orbit setup__orbit--seven"><img src={`${assetRoot}55briWuvaugDSMUeuiiZ7Y2sMwE.svg`} alt="" /></div>
      </div>
      <div class="setup__mark"><img class="setup__vector" src={`${assetRoot}iqCUQqjVGQOT2lPOJOI0QFDw.svg`} alt="" /><img src={`${assetRoot}IrlaVmrhqqAB0OWDiJyxLmXiGw.svg`} alt="Worklane" /></div>
      <small class="setup__status">No switching tools</small>
      <span class="setup__caption">All roads lead to the Worklane unified workspace</span>
    </div>
    <div class="setup__content">
      <span class="section-kicker" data-reveal-child data-reveal-delay="150">How it works</span>
      <h2 data-reveal-child data-reveal-delay="250">A simple setup that gets you moving fast</h2>
      <p data-reveal-child data-reveal-delay="350">Set it up once, bring your team in, and run everything from one dashboard.</p>
      <ol data-setup-list data-reveal-child data-reveal-delay="450">
        {setupSteps.map(([number, title, description], index) => (
          <li data-setup-step>
            <button type="button" aria-expanded={index === 0 ? "true" : "false"} data-setup-button>
              <b>{number}</b><strong>{title}</strong><span aria-hidden="true">+</span>
            </button>
            <div class="setup-step__panel" data-setup-panel hidden={index !== 0}><p>{description}</p></div>
          </li>
        ))}
      </ol>
    </div>
  </section>

  <section class="product section-shell" data-reveal data-reveal-each>
    <div class="product__heading">
      <div><span class="section-kicker" data-reveal-child data-reveal-delay="100">Product overview</span><h2 data-reveal-child data-reveal-delay="200">The foundation of your daily operations</h2></div>
      <Button href="/contact" data-reveal-child data-reveal-delay="300">Get started now</Button>
    </div>
    <div class="product-grid">
      <article class="product-card product-card--tasks" data-reveal-child data-reveal-delay="300">
        <div class="product-card__title"><div class="product-card__heading"><span class="mini-icon mini-icon--purple"><img src={`${assetRoot}UZ3eUBDglnl7af07TopV27CJ5lg.svg`} alt="" /></span><h3>Task Tracking</h3></div><p>Plan work, assign owners, and stay on top of deadlines without switching apps.</p></div>
        <div class="task-dashboard">
          <img class="task-dashboard__sidebar" src={`${assetRoot}BaI6RANvi8mgnBxb3N5tWf8m9A.png`} alt="" />
          <div class="task-dashboard__rows">
            <img class="task-dashboard__dates" src={`${assetRoot}i8dZjD365MID8yaX5RfwvhDEbOY.svg`} alt="" />
            <div class="task-dashboard__marquee" data-task-marquee>
              <div>{["OW04wUmLplkeQ2D1BjULgjdchy4.png", "JTPEqPpVRQVfZQuKxfG3yoLU.png", "UcCPJBzh75RpDgYNUhSaD9GFgw.png", "SPgRhvzBcLanPTdLPxYmfANxKo.png"].map((image) => <img src={`${assetRoot}${image}`} alt="" />)}</div>
              <div aria-hidden="true">{["OW04wUmLplkeQ2D1BjULgjdchy4.png", "JTPEqPpVRQVfZQuKxfG3yoLU.png", "UcCPJBzh75RpDgYNUhSaD9GFgw.png", "SPgRhvzBcLanPTdLPxYmfANxKo.png"].map((image) => <img src={`${assetRoot}${image}`} alt="" />)}</div>
            </div>
          </div>
        </div>
      </article>
      <article class="product-card product-card--client" data-reveal-child data-reveal-delay="400">
        <div class="product-card__title"><div class="product-card__heading"><span class="mini-icon mini-icon--pink"><img src={`${assetRoot}CJHhuons0eIRCMCUkJjNMbUYVoE.svg`} alt="" /></span><h3>Client management</h3></div><p>Keep notes, files, updates, and project status organized for every client.</p></div>
        <div class="client-dashboard" data-feature-cycle="client-orbit" data-cycle-index="0" data-source-component="Feature Card 04" data-source-variant="01">
          {clientStates.map((state, index) => (
            <img
              class:list={["client-dashboard__state", index === 0 && "is-active"]}
              src={`${assetRoot}${state}`}
              alt={index === 0 ? "Acme Corporation client dashboard" : ""}
              aria-hidden={index === 0 ? "false" : "true"}
              data-client-dashboard-state
            />
          ))}
          <div class="client-dashboard__orb" aria-hidden="true">
            <div class="client-dashboard__orb-track">
              {clientIcons.map((icon, index) => (
                <span
                  class:list={[index === 0 && "is-active"]}
                  data-orbit-icon-tile
                  style={`--orbit-icon-angle:${index * 45}deg;--orbit-icon-counter-angle:${index * -45}deg`}
                ><img src={`${assetRoot}${icon}`} alt="" data-orbit-icon /></span>
              ))}
            </div>
          </div>
        </div>
      </article>
      <article class="product-card product-card--team" data-reveal-child data-reveal-delay="500">
        <div class="product-card__title"><div class="product-card__heading"><span class="mini-icon mini-icon--green"><img src={`${assetRoot}5NTuKOdVcev12sAcivioHMHFISw.svg`} alt="" /></span><h3>Team performance</h3></div><p>Spot overload, track completion rates, and understand how the team is working.</p></div>
        <div class="team-dashboard">
          <img src={`${assetRoot}hdbcRhTvi8JAuYGgQkRkBa7MVDM.jpg`} alt="Team performance overview" />
          <div class="team-dashboard__people" aria-label="Team completion examples">
            <div class="team-dashboard__people-track">
              {[0, 1].map((copy) => (
                <div class="team-dashboard__people-group" aria-hidden={copy === 1 ? "true" : undefined}>
                  {teamMembers.map((member) => (
                    <div class="team-dashboard__person">
                      <img src={`${assetRoot}${member.avatar}`} alt="" width="40" height="40" />
                      <span class="team-dashboard__person-name"><strong>{member.name}</strong><small>{member.tasks}</small></span>
                      <b>{member.progress}</b>
                    </div>
                  ))}
                </div>
              ))}
            </div>
          </div>
        </div>
      </article>
      <article class="product-card product-card--revenue" data-reveal-child data-reveal-delay="600">
        <div class="product-card__title"><div class="product-card__heading"><span class="mini-icon mini-icon--orange"><img src={`${assetRoot}IGg3VR0gmQ0RuX3bGSRL7lOh9Zc.svg`} alt="" /></span><h3>Revenue tracking</h3></div><p>See invoices, payments, and monthly totals in one clean dashboard.</p></div>
        <div class="revenue-dashboard"><strong>Total Revenue <b>$142,592</b></strong><div class="chart" data-revenue-chart><svg viewBox="0 0 520 116" role="img" aria-label="Revenue trend"><path class="chart__area" d="M6 91 74 73l74 24 74-40 74 19 74-35 74 14 74-31v91H6Z" /><path class="chart__line" pathLength="1" d="M6 91 74 73l74 24 74-40 74 19 74-35 74 14 74-31" /></svg></div><div class="days"><span>Mon</span><span>Tue</span><span>Wed</span><span>Thur</span><span>Fri</span><span>Sat</span><span>Sun</span></div></div>
      </article>
    </div>
  </section>

  <section class="highlights section-shell" data-reveal>
    <div class="section-heading"><span class="section-kicker" data-reveal-child data-reveal-delay="100">Feature highlights</span><h2 data-reveal-child data-reveal-delay="200">Built to keep your team focused</h2></div>
    <div class="highlights__visual" data-reveal-child><img class="highlights__dashboard" src={`${assetRoot}YCd1n9W7uVlbWwFaKAimKQIZApU.png`} alt="Worklane dashboard overview" width="3600" height="1740" /><img class="highlights__phone" data-scroll-parallax data-scroll-from="30" data-scroll-to="-30" data-scroll-threshold="0.5" src={`${assetRoot}qLq5ZG9mH2DMmBECkGgYcLx2OUY.png`} alt="Worklane mobile dashboard" width="584" height="1200" /></div>
    <div class="highlight-list">{highlightCards.map(([icon, title, description], index) => <article data-reveal-child data-reveal-delay={String(400 + index * 80)}><img src={`${assetRoot}${icon}`} alt="" /><div><h3>{title}</h3><p>{description}</p></div></article>)}</div>
  </section>
</div>

<style>
  .intro-sections { overflow: clip; background: #fff; }
  .section-shell { width: min(100%, 1240px); margin-inline: auto; padding: 150px 30px; }
  .section-heading { display: grid; justify-items: center; max-width: 700px; margin: 0 auto 50px; text-align: center; }
  .features .section-heading { max-width: 700px; }
