---
const columns = [
  {
    title: "Quick Links",
    links: [
      ["Home", "/#hero"],
      ["Features", "/#features"],
      ["AI Automation", "/#ai-automation"],
      ["Use Cases", "/#use-case"],
      ["Pricing", "/#pricing"],
      ["Reviews", "/#reviews"],
    ],
  },
  {
    title: "Company",
    links: [
      ["About", "/about"],
      ["Blog", "/blog"],
      ["Waitlist", "/waitlist"],
      ["Request a Demo", "/request-demo"],
      ["Error 404", "/404"],
    ],
  },
  {
    title: "Support",
    links: [
      ["FAQs", "/faqs"],
      ["Contact", "/contact"],
      ["Changelog", "/changelog"],
      ["Privacy Policy", "/legal-pages/privacy-policy"],
    ],
  },
];

const socialLinks = [
  {
    href: "https://www.instagram.com/",
    label: "Instagram",
    src: "/assets/framerusercontent.com/images/34IacXaquQTJmYNHn7p0KGN72Fw.svg",
  },
  {
    href: "https://www.linkedin.com/",
    label: "LinkedIn",
    src: "/assets/framerusercontent.com/images/J3GkXi9lN72XyEX24dvtlUw.svg",
  },
  {
    href: "https://www.facebook.com",
    label: "Facebook",
    src: "/assets/framerusercontent.com/images/Pj7aaQqVqrLkYHFNxc62MuGWFR4.svg",
  },
  {
    href: "https://x.com/",
    label: "X",
    src: "/assets/framerusercontent.com/images/rXbk3ium3cfYVjaA9zCBemJSXqs.svg",
  },
];

const trialIcon = "/assets/framerusercontent.com/images/jZSEiIQDQQlu40GW0StPMlft4.svg";
const demoIcon = "/assets/framerusercontent.com/images/qcmvLSuiP1j0xJ3cZ9j7QKPglAM.svg";
const submitIcon = "/assets/framerusercontent.com/images/stL0uMNkwH67g1kpOAtwVCfA.svg";
const newsletterFormEndpoint = import.meta.env.PUBLIC_NEWSLETTER_FORM_ENDPOINT?.trim();
const pathname = Astro.url.pathname.replace(/\/$/, "") || "/";
const isCurrent = (href: string) => pathname === href;
---

<footer class="site-footer container">
  <div class="footer-hero dark-stage" data-reveal>
    <div class="footer-background" aria-hidden="true">
      <video
        class="footer-background__video"
        autoplay
        loop
        muted
        playsinline
        preload="auto"
        poster="/assets/framerusercontent.com/images/2MbW1hsDgY4NH6KzX4a5Sy8sg.png"
      >
        <source src="/assets/framerusercontent.com/assets/lTwl9rlW5gtAkoxNfqz25juQfi0.mp4" type="video/mp4" />
      </video>
      <img class="footer-background__pattern" src="/assets/framerusercontent.com/images/IaNCr2d8JUTUZ2bOx135NYqB2wQ.svg" alt="" />
      <div class="footer-background__overlay"></div>
      <img class="footer-background__vector" src="/assets/framerusercontent.com/images/BO3yeXOObi1vJ6Bvmr86KIHgc.svg" alt="" />
      <div class="footer-background__blur footer-background__blur--top"></div>
      <div class="footer-background__blur footer-background__blur--bottom"></div>
    </div>

    <div class="footer-hero__intro">
      <div class="footer-mark" aria-label="Worklane logo" data-reveal>
        <div class="footer-mark__inner">
          <img src="/assets/framerusercontent.com/images/YLGmbFJLUc7ePzTZKDiAgLudS0A.svg" width="45" height="35" alt="" />
        </div>
      </div>
      <h2 data-reveal>Bring your tasks, clients, and revenue together</h2>
      <div class="button-row" data-reveal>
        <a class="button footer-cta footer-cta--trial" href="/contact" data-motion-button>
          <span class="footer-cta__icon-window" aria-hidden="true">
            <span class="footer-cta__icon-track">
              <span class="footer-cta__icon-copy"><img src={trialIcon} alt="" /></span>
              <span class="footer-cta__icon-copy footer-cta__icon-copy--hover"><img src={trialIcon} alt="" /></span>
            </span>
          </span>
          <span class="footer-cta__label-window">
            <span class="footer-cta__label-track">
              <span>Start free trial</span>
              <span aria-hidden="true">Start free trial</span>
            </span>
          </span>
        </a>
        <a class="button footer-cta footer-cta--demo" href="/request-demo" data-motion-button>
          <span class="footer-cta__icon-window" aria-hidden="true">
            <span class="footer-cta__icon-track">
              <span class="footer-cta__icon-copy"><img src={demoIcon} alt="" /></span>
              <span class="footer-cta__icon-copy footer-cta__icon-copy--hover"><img src={demoIcon} alt="" /></span>
            </span>
          </span>
          <span class="footer-cta__label-window">
            <span class="footer-cta__label-track">
              <span>Book a demo</span>
              <span aria-hidden="true">Book a demo</span>
            </span>
          </span>
        </a>
      </div>
      <p data-reveal>Free for 14 days. No card required.</p>
    </div>

    <div class="footer-panel glass" data-reveal>
      <div class="footer-links">
        {
          columns.map((column) => (
            <div class="footer-link-column" data-reveal>
              <h3>{column.title}</h3>
              <ul>
                {column.links.map(([label, href]) => (
                  <li>
                    <a href={href} aria-current={isCurrent(href) ? "page" : undefined}>{label}{label === "AI Automation" && <span class="beta">Beta</span>}</a>
                  </li>
                ))}
              </ul>
            </div>
          ))
        }
        <div class="newsletter" data-reveal>
          <h3>Stay updated on what matters</h3>
          <form action={newsletterFormEndpoint || undefined} method="POST" data-local-form>
            <div class="newsletter__row">
              <label class="sr-only" for="footer-email">Email address</label>
              <input id="footer-email" name="email" type="email" placeholder="Enter your email address" required />
              <button type="submit" aria-label="Subscribe">
                <span class="newsletter__submit-track" aria-hidden="true">
                  <span><img src={submitIcon} alt="" /></span>
                  <span><img src={submitIcon} alt="" /></span>
                </span>
              </button>
            </div>
            <label class="consent"><input type="checkbox" name="consent" value="yes" /> <span>I consent to receive newsletters and updates.</span></label>
            <p class="form-status" aria-live="polite"></p>
          </form>
        </div>
      </div>

      <div class="footer-divider" data-reveal></div>

      <div class="footer-security">
        <div class="footer-security__copy" data-reveal>
          <h3>Security you can trust</h3>
          <p>Built with enterprise-grade security and compliance to keep your data safe at every level.</p>
        </div>
        <div class="security-badges" aria-label="Security certifications" data-reveal>
          <img src="/assets/framerusercontent.com/images/35h3w6M0Ifh20zcL7K5YwJu4wkI.svg" alt="ISO 27001:2013" />
          <img src="/assets/framerusercontent.com/images/ROoMKxcndkRDpR6weBHA3GMWD88.png" alt="AICPA SOC" />
          <img src="/assets/framerusercontent.com/images/zNM0bRPipLxWYFPapuDMWgBGnY.png" alt="GDPR" />
          <img src="/assets/framerusercontent.com/images/Bz44LuuAokOU0hsHRtbKlCqws4w.svg" alt="HIPAA compliant" />
        </div>
      </div>
    </div>

    <div class="footer-bottom" data-reveal>
      <p>Designed by <a href="https://www.webestica.com/" target="_blank" rel="noopener">Webestica</a>, Powered by <a href="https://astro.build/" target="_blank" rel="noopener">Astro</a>.</p>
      <nav aria-label="Social links">
        {socialLinks.map(({ href, label, src }) => (
          <a href={href} target="_blank" rel="noopener" aria-label={label}>
            <span class="social-icon-track">
              <span><img src={src} width="20" height="20" alt="" /></span>
              <span aria-hidden="true"><img src={src} width="20" height="20" alt="" /></span>
            </span>
          </a>
        ))}
      </nav>
    </div>
  </div>
</footer>

<style>
  .site-footer {
    width: 100%;
    max-width: none;
    padding: 0 30px 30px;
    overflow: clip;
  }

  .footer-hero {
    position: relative;
    min-height: 1319.83px;
    padding: 150px 30px 30px;
    color: #fff;
    isolation: isolate;
  }

  .footer-hero::before,
  .footer-hero::after {
    display: none;
  }

  .footer-background,
  .footer-background__video,
  .footer-background__pattern,
  .footer-background__overlay,
  .footer-background__vector,
  .footer-background__blur {
    position: absolute;
    pointer-events: none;
  }

  .footer-background {
    z-index: -1;
    inset: -2px;
    overflow: hidden;
    border-radius: inherit;
  }

  .footer-background__video {
    z-index: 0;
    inset: 0;
    width: 100%;
    height: 100%;
    object-fit: cover;
  }

  .footer-background__pattern {
    z-index: 1;
    top: -50px;
    left: -50px;
    width: calc(100% + 100px);
    height: 780px;
    object-fit: cover;
    object-position: top center;
  }

  .footer-background__overlay {
    z-index: 2;
    inset: 0;
    background: rgba(0, 0, 0, 0.5);
  }

  .footer-background__vector {
    z-index: 3;
    right: -30px;
    bottom: -150px;
    left: -30px;
    width: calc(100% + 60px);
    height: auto;
    aspect-ratio: 3.75;
    opacity: 0.3;
    filter: blur(80px);
    object-fit: contain;
  }

  .footer-background__blur {
    z-index: 4;
    width: 200px;
    height: 500px;
    border-radius: 50%;
    background: #0a0b0b;
    filter: blur(80px);
  }

  .footer-background__blur--top {
    top: -200px;
    right: 50px;
    transform: rotate(100deg);
  }

  .footer-background__blur--bottom {
    top: 30px;
    left: -80px;
    transform: rotate(40deg);
  }

  .footer-hero__intro,
  .footer-panel,
  .footer-bottom {
    position: relative;
    z-index: 5;
  }

  .footer-hero__intro {
    display: flex;
    flex-direction: column;
    align-items: center;
    width: 100%;
    max-width: 700px;
    margin: 0 auto;
    gap: 30px;
    text-align: center;
  }

  .footer-hero__intro > p {
    margin-top: -18px;
  }

  .footer-mark {
    display: flex;
    width: 100px;
    height: 100px;
    align-items: center;
    justify-content: center;
    padding: 10px;
    overflow: hidden;
    border: 1px solid rgba(255, 255, 255, 0.1);
    border-radius: 20px;
    background: #000;
    box-shadow: inset -3px -3px 8px 3px rgba(0, 0, 0, 0.5), inset 3px 3px 8px 3px rgba(0, 0, 0, 0.5);
  }

  .footer-mark__inner {
    display: flex;
    width: 100%;
    height: 100%;
    align-items: center;
    justify-content: center;
    overflow: hidden;
    border-radius: 15px;
    background: linear-gradient(135deg, #674cd0 0%, #2b4993 100%);
    box-shadow: inset -2px -2px 4px rgba(0, 0, 0, 0.5), inset 2px 2px 4px rgba(0, 0, 0, 0.5);
  }

  .footer-mark img {
    display: block;
    width: auto;
    height: 36px;
    flex: none;
  }

  .footer-hero h2 {
    max-width: 700px;
    font-size: 52px;
    font-weight: 500;
    letter-spacing: 0;
    line-height: 1.2;
    text-align: center;
    text-wrap: balance;
  }

  .footer-hero__intro .button-row {
    justify-content: center;
    margin-top: 0;
    gap: 12px 20px;
  }

  .footer-hero__intro > p {
    margin: -18px 0 0;
    color: rgba(255, 255, 255, 0.67);
    font-size: 14px;
    line-height: 1.2;
  }

  .footer-cta {
    display: inline-flex;
    min-height: 0;
    align-items: center;
    justify-content: center;
    overflow: hidden;
    font-family: "Inter Display", sans-serif;
    font-size: 18px;
    font-weight: 600;
    line-height: 1.3;
    text-decoration: none;
    transition: border-color 350ms cubic-bezier(0.44, 0, 0.56, 1), background 350ms cubic-bezier(0.44, 0, 0.56, 1);
  }

  .footer-cta--trial {
    width: 193.58px;
    height: 52px;
    gap: 14px;
    padding: 4px 18px 4px 4px;
    border: 1px solid #fff;
    border-radius: 16px;
    background: linear-gradient(180deg, #fff 0%, #5d5d5d 100%);
    color: #0a0b0b;
  }

  .footer-cta--demo {
    width: 178.84px;
    height: 52px;
    gap: 10px;
    padding: 12px 20px;
    border: 1px solid rgba(255, 255, 255, 0.2);
    border-radius: 16px;
    background: rgba(0, 0, 0, 0.3);
    color: #fff;
    backdrop-filter: blur(20px);
  }

  .footer-cta__icon-window {
    position: relative;
    display: block;
    flex: none;
    overflow: hidden;
  }

  .footer-cta--trial .footer-cta__icon-window {
    width: 44px;
    height: 44px;
    border: 1px solid #000;
    border-radius: 12px;
    background: linear-gradient(180deg, #0a0b0b 0%, #363b3c 100%);
  }

  .footer-cta--demo .footer-cta__icon-window {
    width: 22px;
    height: 22px;
  }

  .footer-cta__icon-track,
  .footer-cta__icon-copy,
  .footer-cta__label-track,
  .footer-cta__label-track > span {
    position: absolute;
  }

  .footer-cta__icon-track {
    inset: 0;
    transition: transform 350ms cubic-bezier(0.44, 0, 0.56, 1);
  }

  .footer-cta__icon-copy {
    inset: 0;
    display: grid;
    place-items: center;
    transition: transform 350ms cubic-bezier(0.44, 0, 0.56, 1);
  }

  .footer-cta__icon-copy--hover {
    transform: translate(-100%, 100%) rotate(-18deg);
  }

  .footer-cta__icon-copy img {
    display: block;
    width: auto;
    height: auto;
    object-fit: contain;
  }

  .footer-cta__label-window {
    position: relative;
    display: block;
    min-width: 0;
    flex: 1 1 auto;
    height: 24px;
    overflow: hidden;
    line-height: 1.3;
  }

  .footer-cta__label-track {
    inset: 0;
    display: block;
    transition: transform 350ms cubic-bezier(0.44, 0, 0.56, 1);
  }

  .footer-cta__label-track > span {
    display: block;
    white-space: nowrap;
  }

  .footer-cta__label-track > span:last-child {
    top: 30px;
    left: 0;
  }

  .footer-cta:hover .footer-cta__icon-track,
  .footer-cta:focus-visible .footer-cta__icon-track {
    transform: translate(100%, -100%);
  }

  .footer-cta:hover .footer-cta__icon-copy,
  .footer-cta:focus-visible .footer-cta__icon-copy {
    transform: rotate(18deg);
  }

  .footer-cta:hover .footer-cta__icon-copy--hover,
  .footer-cta:focus-visible .footer-cta__icon-copy--hover {
    transform: translate(-100%, 100%) rotate(0deg);
  }

  .footer-cta:hover .footer-cta__label-track,
  .footer-cta:focus-visible .footer-cta__label-track {
    transform: translateY(-30px);
  }

  .footer-panel {
    display: flex;
    flex-direction: column;
    gap: 70px;
    width: 100%;
    max-width: 1180px;
    min-height: 632.22px;
    margin-inline: auto;
    margin-top: 80px;
    padding: 70px;
    border: 1px solid rgba(255, 255, 255, 0.1);
    border-radius: 20px;
    background: rgba(0, 0, 0, 0.3);
    box-shadow: none;
    backdrop-filter: blur(20px);
  }

  .footer-links {
    display: grid;
    grid-template-rows: repeat(2, min-content);
    grid-template-columns: repeat(5, minmax(50px, 1fr));
    gap: 30px;
  }

  .footer-link-column,
  .newsletter {
    min-width: 0;
  }

  .newsletter {
    grid-column: span 2;
  }

  .footer-panel h3 {
    margin: 0 0 20px;
    color: #fff;
    font-family: "Stack Sans Headline", sans-serif;
    font-size: 22px;
    font-weight: 600;
    letter-spacing: 0;
    line-height: 1.4;
  }

  .footer-panel ul {
    display: grid;
    gap: 16px;
    margin: 0;
    padding: 0;
    list-style: none;
  }

  .footer-panel li,
  .footer-panel p,
  .consent {
    color: var(--soft);
    font-family: "Inter Display", sans-serif;
    font-size: 16px;
    font-weight: 500;
    letter-spacing: 0.3px;
    line-height: 1.2;
  }

  .footer-panel a {
    color: var(--soft);
    transition: color 350ms cubic-bezier(0.44, 0, 0.56, 1);
  }

  .footer-panel a:hover,
  .footer-panel a:focus-visible,
  .footer-panel a[aria-current="page"] {
    color: #fff;
  }

  .beta {
    display: inline-block;
    margin-left: 5px;
    padding: 2px 5px;
    border-radius: 4px;
    background: var(--purple);
    color: #fff;
    font-size: 12px;
    letter-spacing: 0;
    line-height: 1;
  }

  .newsletter form {
    display: grid;
    max-width: 400px;
    gap: 16px;
  }

  .newsletter .form-status:empty {
    display: none;
  }

  .newsletter .form-status[data-submit-state="unconfigured"],
  .newsletter .form-status[data-submit-state="error"] {
    color: #ffb8b8;
  }

  .newsletter .form-status[data-submit-state="pending"] {
    color: #a4a4a4;
  }

  .newsletter__row {
    display: flex;
    gap: 10px;
    width: 100%;
  }

  .newsletter input[type="email"] {
    min-width: 0;
    height: 54px;
    flex: 1;
    padding: 10px 20px;
    border: 1px solid rgba(255, 255, 255, 0.1);
    border-radius: 10px;
    background: rgba(255, 255, 255, 0.05);
    color: #fff;
    font: 500 16px/1.2 "Inter Display", sans-serif;
    letter-spacing: 0.3px;
    outline: none;
    transition: border-color 450ms cubic-bezier(0.44, 0, 0.56, 1);
  }

  .newsletter input[type="email"]::placeholder {
    color: var(--soft);
    opacity: 1;
  }

  .newsletter input[type="email"]:focus {
    border-color: #fff;
  }

  .newsletter button {
    position: relative;
    width: 54px;
    height: 54px;
    flex: none;
    overflow: hidden;
    border: 1px solid #fff;
    border-radius: 10px;
    background: linear-gradient(180deg, #fff 0%, #c9c9c9 100%);
    cursor: pointer;
  }

  .newsletter__submit-track {
    position: absolute;
    inset: 0;
    display: block;
    transition: transform 350ms cubic-bezier(0.44, 0, 0.56, 1);
  }

  .newsletter__submit-track > span {
    position: absolute;
    inset: 0;
    display: grid;
    place-items: center;
  }

  .newsletter__submit-track > span:last-child {
    transform: translate(-54px, 54px) rotate(-18deg);
  }

  .newsletter button:hover .newsletter__submit-track,
  .newsletter button:focus-visible .newsletter__submit-track {
    transform: translate(54px, -54px);
  }

  .newsletter__submit-track img {
    width: 26px;
    height: 24px;
    object-fit: contain;
  }

  .consent {
    display: flex;
    align-items: center;
    gap: 6px;
    font-size: 14px;
    line-height: 1.2;
  }

  .consent span,
  .footer-security p {
    text-wrap: balance;
  }

  .consent input {
    appearance: none;
    width: 16px;
    height: 16px;
    flex: none;
    margin: 0;
    border: 1px solid rgba(255, 255, 255, 0.1);
    border-radius: 4px;
    background: rgba(255, 255, 255, 0.05);
    transition: all 450ms cubic-bezier(0.44, 0, 0.56, 1);
  }

  .consent input:checked {
    border-color: #fff;
    background: #fff;
    box-shadow: inset 0 0 0 3px #0a0b0b;
  }

  .consent input:focus-visible,
  .newsletter button:focus-visible,
  .footer-bottom nav a:focus-visible {
    outline: 2px solid #fff;
    outline-offset: 3px;
  }

  .footer-divider {
    width: 100%;
    height: 1px;
    background: rgba(255, 255, 255, 0.1);
  }

  .footer-security {
    display: flex;
    align-items: center;
    justify-content: space-between;
    gap: 30px;
    margin-top: 0;
    padding-top: 0;
    border-top: 0;
  }

  .footer-security__copy {
    flex: 1;
  }

  .footer-security h3 {
    margin-bottom: 4px;
  }

  .security-badges {
    display: flex;
    flex: 1;
    flex-wrap: wrap;
    align-items: center;
    justify-content: flex-end;
    gap: 20px;
  }

  .security-badges img {
    width: auto;
    height: 60px;
    max-width: none;
    object-fit: contain;
  }

  .footer-bottom {
    display: flex;
    align-items: center;
    justify-content: space-between;
    gap: 100px;
    width: 100%;
    max-width: 1180px;
    margin: 30px auto 0;
    padding: 0;
  }

  .footer-bottom > p {
    flex: 1;
    color: var(--soft);
    font: 500 14px/1.2 "Inter Display", sans-serif;
    letter-spacing: 0.3px;
  }

  .footer-bottom nav {
    display: flex;
    flex: 0.6;
    flex-wrap: wrap;
    justify-content: flex-end;
    gap: 16px;
  }

  .footer-bottom nav a {
    position: relative;
    display: flex;
    width: 32px;
    height: 32px;
    align-items: center;
    justify-content: center;
    overflow: hidden;
    border: 1px solid rgba(255, 255, 255, 0.1);
    border-radius: 10px;
    background: rgba(255, 255, 255, 0.05);
  }

  .social-icon-track {
    position: relative;
    display: flex;
    width: 14px;
    height: 14px;
    flex-direction: column;
    align-items: center;
    justify-content: flex-start;
    overflow: hidden;
    gap: 10px;
    transition: transform 450ms cubic-bezier(0.34, 1.56, 0.64, 1);
  }

  .social-icon-track > span {
    display: flex;
    width: 14px;
    height: 14px;
    flex: none;
    align-items: center;
    justify-content: center;
  }

  .social-icon-track img {
    display: block;
    width: 14px;
    height: 14px;
    object-fit: contain;
  }

  .footer-bottom nav a:hover .social-icon-track,
  .footer-bottom nav a:focus-visible .social-icon-track {
    transform: translateY(-24px);
  }

  .sr-only {
    position: absolute;
    width: 1px;
    height: 1px;
