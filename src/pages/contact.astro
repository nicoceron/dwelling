---
import BaseLayout from "../layouts/BaseLayout.astro";
import Button from "../components/Button.astro";
const contactFormEndpoint = import.meta.env.PUBLIC_CONTACT_FORM_ENDPOINT?.trim();

const supportCards = [
  { icon: "/assets/framerusercontent.com/images/ila9WUaQ4ErrIObLS4d93ZHZT0.svg", title: "Customer support", description: "Get help with your account and product usage.", label: "Get support", href: "mailto:support@example.com" },
  { icon: "/assets/framerusercontent.com/images/p9GQrADSyT9twsUxmP53dZX9eY.svg", title: "Read documentation", description: "Browse setup guides and product explanations to get answers quickly.", label: "View docs", href: "https://www.framer.com/blog/documentation-in-framer/" },
  { icon: "/assets/framerusercontent.com/images/aP3hl3lOeGzxt12VLKmP9eiUO9k.svg", title: "Product demo", description: "Explore core features and workflows in a live product demo.", label: "Request a demo", href: "/request-demo" },
];

const faqs = [
  { question: "Do I need a credit card to start?", answer: "No. You can start the free trial with just your email. No payment details required." },
  { question: "Can I cancel my subscription anytime?", answer: "Yes. You can cancel at any time from your account settings. There are no long-term contracts." },
  { question: "Is this suitable for small teams only?", answer: "It’s designed for small and growing teams, but it scales as your team and client list grow." },
  { question: "How long does setup take?", answer: "Most teams are up and running in under five minutes. No complicated onboardin" },
  { question: "Is my data secure?", answer: "Yes. Your data is encrypted and securely stored. We never share it with third parties." },
];
---

<BaseLayout title="Worklane – Workflow Automation SaaS Framer Template" description="Launch an automation-focused SaaS website with Worklane. A modern Framer template designed for clarity, speed, and growth.">
  <div class="contact-page">
    <section class="contact-hero" data-reveal>
      <div class="contact-hero__stage dark-stage" data-reveal-child data-reveal-delay="100">
        <div class="contact-hero__background" aria-hidden="true">
          <video autoplay loop muted playsinline preload="auto" poster="/assets/framerusercontent.com/images/c1blVMHg8J0d8AnJtROLkvG9twQ.png"><source src="/assets/framerusercontent.com/assets/W3DDaVw09q9iUrlq729foZMn9o.mp4" type="video/mp4" /></video>
          <div></div>
        </div>
        <div class="contact-hero__content">
          <div class="contact-hero__copy">
            <div class="contact-hero__intro">
              <span class="eyebrow" data-reveal-child data-reveal-delay="200"><i class="eyebrow__dot" aria-hidden="true"></i><span>Contact us</span><i class="eyebrow__dot" aria-hidden="true"></i></span>
              <h1 data-reveal-child data-reveal-delay="300">Let’s discuss<br class="contact-main-break" /> how we<br class="tablet-break" /> can help</h1>
              <p data-reveal-child data-reveal-delay="400">Whether you’re exploring the product, need help, or want to discuss a setup, we’re here to help you move forward.</p>
            </div>
            <figure class="testimonial" data-reveal-child data-reveal-delay="500">
              <blockquote>“The team took time to understand our setup before suggesting anything. That made all the difference.”</blockquote>
              <figcaption><img src="/assets/framerusercontent.com/images/hYfCvJ3IVdEznEOwIQiiAxWOsPY.jpg" width="150" height="150" alt="Sarah Collins" /><span><strong>Sarah Collins</strong><small>Operations Lead, Brightway</small></span></figcaption>
            </figure>
          </div>
          <form class="contact-form" action={contactFormEndpoint || undefined} method="POST" data-local-form data-reveal-child data-reveal-delay="600">
            <div class="contact-form__fields">
              <label class="field"><span>Name*</span><div class="input-shell"><input type="text" name="Name" placeholder="Your full name" required /></div></label>
              <label class="field"><span>Company name</span><div class="input-shell"><input type="text" name="Company" placeholder="Your company name" /></div></label>
              <label class="field"><span>Email address*</span><div class="input-shell"><input type="email" name="Email address" placeholder="Your email address" required /></div></label>
              <label class="field"><span>Phone number</span><div class="input-shell"><input type="tel" name="Phone Number" placeholder="Your phone number" /></div></label>
              <label class="field field--message"><span>Message*</span><div class="input-shell"><textarea name="Message" placeholder="Briefly describe your question or request." required></textarea></div></label>
              <label class="consent contact-form__consent"><input type="checkbox" name="Privacy Policy" /> <span>I agree to receive emails and accept the <a href="/legal-pages/privacy-policy">privacy policy</a>.</span></label>
            </div>
            <Button type="submit" icon="→">Send message</Button><p class="form-status" aria-live="polite"></p>
          </form>
        </div>
      </div>
    </section>
    <section class="support-section" data-reveal>
      <div class="support-heading"><span class="eyebrow"><i class="eyebrow__dot" aria-hidden="true"></i><span>Support resources</span><i class="eyebrow__dot" aria-hidden="true"></i></span><h2>Other ways to<span class="support-mobile-break"><br /></span> get help</h2></div>
      <div class="support-grid container">
        {supportCards.map((card) => <article class="support-card" data-reveal-child><span class="support-icon"><img src={card.icon} width="24" height="24" alt="" /></span><div class="support-card__content"><h2>{card.title}</h2><p>{card.description}</p></div><Button href={card.href}>{card.label}</Button></article>)}
      </div>
    </section>
    <section class="faq-section" data-reveal>
      <div class="faq-heading"><span class="eyebrow"><i class="eyebrow__dot" aria-hidden="true"></i><span>FAQs</span><i class="eyebrow__dot" aria-hidden="true"></i></span><h2>Answers to common questions</h2></div>
      <div class="faq-list contact-faq" data-accordion data-single="false">
        {faqs.map((item, index) => {
          const panelId = `faq-panel-${index}`;
          return <article class="faq-item" data-accordion-item><h3><button type="button" aria-expanded={index === 0} aria-controls={panelId} data-accordion-button><span>{item.question}</span><span class="faq-item__icon" aria-hidden="true">+</span></button></h3><div class="faq-item__panel" id={panelId} data-accordion-panel hidden={index !== 0}><p>{item.answer}</p></div></article>;
        })}
      </div>
    </section>
  </div>
</BaseLayout>

<style>
  .contact-hero { height:1064.81px; min-height:1064.81px; padding:0 30px 150px; }
  .contact-hero__stage { height:914.81px; min-height:914.81px; padding:150px 100px; }
  .contact-hero__stage::before { z-index:-3; background:#07080a; }
  .contact-hero__background { position:absolute; z-index:-2; inset:-2px; overflow:hidden; border-radius:inherit; }
  .contact-hero__background video,.contact-hero__background > div { position:absolute; inset:0; width:100%; height:100%; object-fit:cover; }
  .contact-hero__background > div { z-index:1; background:#0a0b0b; opacity:.5; }
  .contact-hero__content { display:grid; max-width:1180px; height:614.81px; min-height:614.81px; margin:0 auto; grid-template-columns:544.73px 1fr; gap:30px; }
  .contact-hero__copy { display:flex; min-width:0; flex-direction:column; justify-content:space-between; }
  .contact-hero__intro { display:grid; justify-items:start; }
  .contact-hero .eyebrow { border-color:rgba(255,255,255,.13); background:rgba(255,255,255,.08); color:#fff; }
  .contact-hero h1 { max-width:544.73px; margin-top:10px; color:#fff; font-size:62px; line-height:68.2px; text-wrap:balance; }
  .tablet-break { display:none; }
  .contact-hero__intro > p { max-width:544.73px; margin-top:30px; color:#fff; opacity:.8; font-family:"Inter Display",sans-serif; font-size:20px; font-weight:500; line-height:28px; text-wrap:balance; }
  .testimonial { max-width:500px; margin:0; }
  .testimonial blockquote { max-width:500px; margin:0; color:#fff; font-family:"Inter Display",sans-serif; font-size:20px; font-weight:500; line-height:28px; text-wrap:balance; }
  .testimonial figcaption { display:flex; align-items:center; gap:10px; margin-top:20px; }
  .testimonial img { width:50px; height:50px; border-radius:50%; object-fit:cover; }
  .testimonial figcaption span { display:grid; gap:2px; }
  .testimonial strong { color:#fff; font-family:"Inter Display",sans-serif; font-size:18px; font-weight:500; line-height:25.2px; }
  .testimonial small { color:#a4a4a4; font-family:"Inter Display",sans-serif; font-size:14px; font-weight:500; letter-spacing:.3px; line-height:16.8px; }
  .contact-form { display:flex; width:100%; height:614.81px; min-width:0; min-height:614.81px; flex-direction:column; padding:50px; border:0; border-radius:20px; background:rgba(0,0,0,.5); overflow:hidden; }
  .contact-form__fields { display:grid; grid-template-columns:repeat(2,minmax(0,1fr)); row-gap:30px; column-gap:30px; }
  .contact-form .field { display:flex; min-height:89.2px; flex-direction:column; gap:10px; }
  .contact-form .field > span { color:#a4a4a4; font-family:"Inter Display",sans-serif; font-size:18px; font-weight:500; line-height:25.2px; }
  .contact-form .input-shell { height:54px; min-height:54px; border:1px solid rgba(255,255,255,.09); border-radius:11px; background:rgba(255,255,255,.06); }
  .contact-form input:not([type="checkbox"]) { width:calc(100% - 40px); height:34px; min-height:34px; margin:10px 20px; padding:0; border:0; border-radius:0; background:transparent; color:#fff; font-family:"Inter Display",sans-serif; font-size:16px; line-height:19.2px; outline:0; }
  .contact-form textarea { width:100%; height:120px; min-height:120px; margin:0; padding:20px; border:0; border-radius:0; background:transparent; color:#fff; font-family:"Inter Display",sans-serif; font-size:16px; line-height:19.2px; outline:0; resize:none; }
  .contact-form input::placeholder,.contact-form textarea::placeholder { color:rgba(255,255,255,.5); }
  .contact-form .field--message { grid-column:1/-1; min-height:155.2px; gap:10px; }
  .contact-form .field--message .input-shell { height:120px; min-height:120px; }
  .contact-form__consent { display:flex; grid-column:1/-1; min-height:19.2px !important; flex-direction:row !important; align-items:flex-start; gap:6px !important; margin-top:-10px; color:#a4a4a4; font-family:"Inter Display",sans-serif; font-size:16px; font-weight:500; letter-spacing:.3px; line-height:19.2px; }
  .contact-form__consent input { display:grid; width:16px; height:16px; flex:0 0 16px; margin:0; place-items:center; appearance:none; border:1px solid rgba(255,255,255,.14); border-radius:4px; background:#101213; cursor:pointer; }
  .contact-form__consent input:checked { border-color:#fff; background:#fff; }
  .contact-form__consent input:checked::after { width:7px; height:4px; border:solid #0a0b0b; border-width:0 0 2px 2px; content:""; transform:translateY(-1px) rotate(-45deg); }
  .contact-form__consent a { color:#fff; text-decoration:underline; }
  .contact-form__consent > span { text-wrap:balance; }
  :global(.contact-form > .button) { width:201.27px; height:52px; min-height:52px; margin-top:30px; padding:4px 18px 4px 4px; border:0; border-radius:16px; background:linear-gradient(180deg,#fff 0%,#c9c9c9 100%); color:#0a0b0b; font-family:"Inter Display",sans-serif; font-size:18px; line-height:23.4px; }
  :global(.contact-form > .button .button__icon-window) { width:44px; height:44px; flex-basis:44px; border-radius:12px; background:linear-gradient(180deg,#0a0b0b 0%,#363b3c 100%); color:#fff; }
  .contact-form .form-status { color:#a9df83; }
  .contact-form .form-status:empty { display:none; }
  .contact-form .form-status[data-submit-state="unconfigured"],
  .contact-form .form-status[data-submit-state="error"] { color:#ffb8b8; }
  .contact-form .form-status[data-submit-state="pending"] { color:#a4a4a4; }
  .contact-form[data-submit-state] { height:auto; overflow:visible; }
  .support-section { min-height:624.41px; }
  .support-heading,.faq-heading { display:grid; justify-items:center; max-width:700px; margin:0 auto; text-align:center; }
  .support-heading h2,.faq-heading h2 { width:100%; margin-top:10px; font-size:52px; line-height:62.4px; text-wrap:balance; }
  .support-grid { display:grid; width:1180px; max-width:1180px; height:319.2px; margin-top:50px; padding:0; grid-template-columns:repeat(3,minmax(0,1fr)); gap:30px; }
  .support-card { display:flex; min-width:0; height:319.2px; flex-direction:column; padding:30px; border-radius:20px; background:#f8f9fa; box-shadow:inset 0 0 0 1px rgba(10,11,11,.1); }
  .support-icon { display:flex; width:50px; height:50px; flex-shrink:0; align-items:center; justify-content:center; border-radius:10px; }
  .support-card:nth-child(1) .support-icon { background:linear-gradient(144deg,#f045aa 0%,#eeaad2 100%); }
  .support-card:nth-child(2) .support-icon { background:linear-gradient(144deg,#674cd0 0%,#a8a8ff 100%); }
  .support-card:nth-child(3) .support-icon { background:linear-gradient(144deg,#67a429 0%,#aee576 100%); }
  .support-icon img { width:24px; height:24px; object-fit:contain; }
  .support-card__content { display:grid; gap:6px; margin-top:50px; }
  .support-card h2 { margin:0; font-size:22px; font-weight:600; line-height:30.8px; }
  .support-card p { margin:0; color:#545454; font-family:"Inter Display",sans-serif; font-size:18px; font-weight:500; line-height:25.2px; text-wrap:balance; }
  :global(.support-card .button) { width:fit-content; height:52px; min-height:52px; margin-top:20px; gap:14px; padding:4px 18px 4px 4px; border:0; border-radius:16px; background:linear-gradient(180deg,#0a0b0b 0%,#363b3c 100%); color:#fff; font-family:"Inter Display",sans-serif; font-size:18px; line-height:23.4px; }
  :global(.support-card .button .button__icon-window) { width:44px; height:44px; flex-basis:44px; border-radius:12px; background:linear-gradient(180deg,#fff 0%,#c9c9c9 100%); color:#0a0b0b; }
  .faq-section { min-height:736.81px; }
  .faq-section :global(.contact-faq) { display:grid; width:700px; min-height:369.2px; margin:50px auto 0; gap:20px; }
  .faq-section :global(.faq-item) { min-height:0; }
  .faq-section :global(.faq-item h3) { margin:0; }
  .faq-section :global(.faq-item button) { display:grid; width:100%; height:46px; min-height:46px; grid-template-columns:1fr 46px; align-items:center; gap:10px; padding:0; border:0; border-radius:5px; background:transparent; text-align:left; }
  .faq-section :global(.faq-item button[aria-expanded="true"]) { color:#fff; }
  .faq-section :global(.faq-item button > span:first-child) { display:flex; min-height:46px; align-items:center; padding:12px 26px; border-radius:10px; box-shadow:inset 0 0 0 1px rgba(10,11,11,.1); font-family:"Stack Sans Headline",sans-serif; font-size:18px; font-weight:600; line-height:21.6px; text-wrap:balance; }
  .faq-section :global(.faq-item__icon) { position:relative; display:grid; width:46px; height:46px; place-items:center; border:0; border-radius:10px; box-shadow:inset 0 0 0 1px rgba(10,11,11,.1); background:transparent; font-size:0; }
  .faq-section :global(.faq-item button[aria-expanded="true"] > span:first-child),
  .faq-section :global(.faq-item button[aria-expanded="true"] .faq-item__icon) { background:#0a0b0b; }
  .faq-section :global(.faq-item__icon::before),
  .faq-section :global(.faq-item__icon::after) { position:absolute; width:14px; height:2px; border-radius:3px; background:currentColor; content:""; transition:transform 350ms ease; }
  .faq-section :global(.faq-item__icon::before) { top:50%; left:50%; transform:translate(-50%,-50%); }
  .faq-section :global(.faq-item__icon::after) { top:50%; left:50%; transform:translate(-50%,-50%) rotate(90deg); }
  .faq-section :global(.faq-item button[aria-expanded="true"] .faq-item__icon::before) { transform:translate(-50%,-50%) rotate(45deg); }
  .faq-section :global(.faq-item button[aria-expanded="true"] .faq-item__icon::after) { transform:translate(-50%,-50%) rotate(-45deg); }
  .faq-section :global(.faq-item__panel) { min-height:0; margin:0; padding:12px 26px 12px; overflow:hidden; border-radius:10px; background:#f8f9fa; box-shadow:inset 0 0 0 1px rgba(10,11,11,.1); }
  .faq-section :global(.faq-item__panel p) { font-family:"Inter Display",sans-serif; font-size:18px; line-height:25.2px; text-wrap:balance; }
  .contact-page .eyebrow,.contact-page .eyebrow__dot { box-sizing:border-box; }
  .contact-page .eyebrow { height:32.8px; padding:8px 20px; gap:10px; font-family:"Inter Display",sans-serif; font-size:14px; font-weight:500; letter-spacing:.3px; line-height:16.8px; }
  .contact-hero .eyebrow { width:max-content; min-width:139.5px; white-space:nowrap; }
  .support-heading .eyebrow { width:188.02px; border:0; box-shadow:inset 0 0 0 1px var(--line); }
  .support-heading .eyebrow > span { flex-shrink:0; white-space:nowrap; }
  .faq-heading .eyebrow { width:102.13px; }
  .support-mobile-break { display:none; }
  .contact-page .eyebrow__dot { display:block; width:4px; height:4px; flex:0 0 4px; border-radius:50%; background:currentColor; }
  @media (max-width:1199px) {
    .contact-hero { height:1221.42px; min-height:1221.42px; padding:79px 30px 120px; }
    .contact-hero__stage { height:1022.42px; min-height:1022.42px; padding:70px 30px; }
    .contact-hero__content { height:832.42px; min-height:832.42px; grid-template-columns:330px 330px; gap:30px; }
    .contact-hero h1 { font-size:50px; line-height:55px; }
    .tablet-break { display:initial; }
    .contact-form { height:832.42px; min-height:832.42px; padding:30px; }
    .contact-form__fields { grid-template-columns:1fr; }
    .support-section { min-height:870.41px; }
    .support-heading h2,.faq-heading h2 { font-size:42px; line-height:50.4px; }
    .support-grid { width:750px; max-width:750px; height:627.2px; margin-top:30px; padding:0; grid-template-columns:repeat(2,360px); gap:30px; }
    .support-card { height:311.2px; }
    .support-card:last-child { grid-column:1/-1; width:750px; height:286px; }
    :global(.support-card .button) { height:44px; min-height:44px; gap:10px; padding-right:14px; }
    :global(.support-card .button .button__icon-window) { width:36px; height:36px; flex-basis:36px; border-radius:10px; }
    .faq-section { min-height:612.41px; }
    .faq-section :global(.contact-faq) { width:700px; margin-top:30px; }
  }
  @media (max-width:809px) {
    .contact-hero { height:auto; min-height:0; padding:52px 10px 100px; }
    .contact-hero__stage { height:auto; min-height:0; padding:70px 20px; }
    .contact-hero__content { display:flex; height:auto; min-height:0; flex-direction:column; gap:40px; }
    .contact-hero__copy { min-height:0; justify-content:flex-start; }
    .contact-hero h1 { width:100%; max-width:none; margin-top:10px; font-size:40px; line-height:44px; }
    .contact-main-break { display:none; }
    .tablet-break { display:none; }
    .contact-hero__intro > p { margin-top:16px; font-size:18px; line-height:25.2px; }
    .testimonial { margin-top:40px; }
    .testimonial blockquote { font-size:18px; line-height:25.2px; }
    .contact-form { height:auto; min-height:0; padding:20px; }
    .contact-form__fields { row-gap:30px; }
    .contact-form .field--message,.contact-form__consent { grid-column:auto; }
    .support-section { min-height:0; padding:0 20px 100px; }
    .support-heading { width:min(100%,700px); }
    .faq-heading { width:min(100%,720px); max-width:none; }
    .support-heading h2,.faq-heading h2 { font-size:36px; line-height:43.2px; }
    .support-mobile-break { display:none; }
    .support-grid { width:100%; max-width:none; height:auto; margin-top:20px; padding:0; grid-template-columns:1fr; gap:30px; }
    .support-card,.support-card:last-child { width:100%; height:auto; padding:20px; }
    .support-card h2 { font-size:20px; line-height:28px; }
    :global(.support-card .button) { margin-top:20px; }
    :global(.support-card .button .button__icon-window) { width:36px; height:36px; flex-basis:36px; border-radius:10px; }
    .faq-section { min-height:0; padding:0 20px 100px; }
    .faq-heading h2 { margin-top:10px; }
    .faq-section :global(.contact-faq) { width:min(100%,720px); min-height:0; margin-top:20px; gap:20px; }
    .faq-section :global(.faq-item) { display:flex; flex-direction:column; gap:10px; }
    .faq-section :global(.faq-item button) { height:auto; min-height:38px; grid-template-columns:1fr 38px; }
    .faq-section :global(.faq-item button[aria-expanded="true"]) { padding-left:0; }
    .faq-section :global(.faq-item button > span:first-child) { min-height:38px; padding:8px 16px; font-size:16px; line-height:19.2px; }
    .faq-section :global(.faq-item__icon) { width:38px; height:38px; }
    .faq-section :global(.faq-item__panel) { padding:8px 16px; }
    .faq-section :global(.faq-item__panel p) { font-size:18px; line-height:25.2px; }
  }
</style>
