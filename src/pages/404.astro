---
import BaseLayout from "../layouts/BaseLayout.astro";
---

<BaseLayout
  title="Worklane – Workflow Automation SaaS Framer Template"
  description="Launch an automation-focused SaaS website with Worklane. A modern Framer template designed for clarity, speed, and growth."
>
  <div class="error-page">
    <section class="error-hero">
      <div class="error-content">
        <div class="error-code" data-hero-reveal data-delay="100">404</div>
        <h1 data-hero-reveal data-delay="250">Page not found</h1>
        <p data-hero-reveal data-delay="250">The page you are looking for doesn't exist or has been moved.</p>
        <a class="button error-button" href="/" data-motion-button data-hero-reveal data-delay="400">
          <span class="error-button__icon-window" aria-hidden="true">
            <span class="error-button__icon-track">
              <span class="error-button__icon-copy"><img src="/assets/framerusercontent.com/images/6sHcZPG5UnSri9HDmdl6YL8iutY.svg" alt="" width="17" height="15" /></span>
              <span class="error-button__icon-copy error-button__icon-copy--hover"><img src="/assets/framerusercontent.com/images/6sHcZPG5UnSri9HDmdl6YL8iutY.svg" alt="" width="17" height="15" /></span>
            </span>
          </span>
          <span class="error-button__label-window">
            <span class="error-button__label-track">
              <span class="error-button__label">Back to home</span>
              <span class="error-button__label error-button__label--hover" aria-hidden="true">Back to home</span>
            </span>
          </span>
        </a>
      </div>
    </section>
  </div>
</BaseLayout>

<style>
  .error-page { overflow: hidden; }
  .error-hero { min-height: 606px; padding-top: 120px; }
  .error-content { width: min(calc(100% - 60px), 700px); margin-inline: auto; text-align: center; }
  .error-code { color: #674cd0; background: linear-gradient(280deg, #a8a8ff 0%, #674cd0 100%); background-clip: text; -webkit-text-fill-color: transparent; font-family: "Stack Sans Headline", "Stack Sans Headline Placeholder", sans-serif; font-size: 220px; font-weight: 500; line-height: .7; letter-spacing: normal; }
  .error-content h1 { margin-top: 34px; font-size: 28px; line-height: 1.2; }
  .error-content p { margin-top: 4px; color: #545454; font-size: 20px; line-height: 1.4; text-wrap: balance; }
  :global(.error-content .error-button) {
    display: flex;
    width: 192.28px;
    min-height: 52px;
    margin: 30px auto 0;
    justify-content: flex-start;
    gap: 14px;
    padding: 4px 18px 4px 4px;
    border: 0;
    border-radius: 16px;
    background: linear-gradient(180deg, #0a0b0b 0%, #363b3c 100%);
    font-size: 18px;
    font-weight: 600;
    line-height: 23.4px;
  }
  :global(.error-content .error-button:focus-visible) { outline: 1px auto Highlight; outline-offset: 1px; }
  :global(.error-button__icon-window) {
    position: relative;
    display: grid;
    width: 44px;
    height: 44px;
    flex: none;
    place-items: center;
    overflow: hidden;
    border-radius: 12px;
    background: linear-gradient(180deg, #fff 0%, #c9c9c9 100%);
  }
  :global(.error-button__icon-track),
  :global(.error-button__icon-copy) { position: absolute; inset: 0; transition: transform 350ms cubic-bezier(.44, 0, .56, 1); }
  :global(.error-button__icon-copy) { display: grid; place-items: center; }
  :global(.error-button__icon-copy:not(.error-button__icon-copy--hover)) { transform: translateX(-37px); }
  :global(.error-button__icon-window img) { width: 17px; height: 15px; }
  :global(.error-button:hover .error-button__icon-copy:not(.error-button__icon-copy--hover)),
  :global(.error-button:focus-visible .error-button__icon-copy:not(.error-button__icon-copy--hover)) { transform: translateX(0); }
  :global(.error-button:hover .error-button__icon-copy--hover),
  :global(.error-button:focus-visible .error-button__icon-copy--hover) { transform: translateX(37px); }
  :global(.error-button__label-window) { position: relative; display: block; height: 23.4px; overflow: hidden; line-height: 23.4px; }
  :global(.error-button__label-track) { position: relative; display: block; height: 100%; transition: transform 350ms cubic-bezier(.44, 0, .56, 1); }
  :global(.error-button__label) { display: block; white-space: nowrap; }
  :global(.error-button__label--hover) { position: absolute; top: 53.4px; left: 0; }
  :global(.error-button:hover .error-button__label-track), :global(.error-button:focus-visible .error-button__label-track) { transform: translateY(-53.4px); }


  @media (max-width: 1199px) {
    .error-hero { min-height: 503px; padding-top: 140px; }
    .error-code { font-size: 160px; line-height: .7; }
    .error-content h1 { margin-top: 34px; font-size: 26px; line-height: 1.2; }
    .error-content p { margin-top: 4px; font-size: 20px; line-height: 1.4; }
    :global(.error-content .error-button) { width: 176.28px; min-height: 44px; gap: 10px; padding: 4px 14px 4px 4px; border-radius: 16px; font-size: 18px; line-height: 23.4px; }
    :global(.error-button__icon-window) { width: 36px; height: 36px; border-radius: 10px; }
    :global(.error-button__label-window) { height: 23.4px; line-height: 23.4px; }
    :global(.error-button__label--hover) { display: none; }
    :global(.error-button:hover .error-button__label-track),
    :global(.error-button:focus-visible .error-button__label-track) { transform: none; }
    :global(.error-button:hover .error-button__icon-copy:not(.error-button__icon-copy--hover)),
    :global(.error-button:focus-visible .error-button__icon-copy:not(.error-button__icon-copy--hover)) { transform: translateX(-37px); }
    :global(.error-button:hover .error-button__icon-copy--hover),
    :global(.error-button:focus-visible .error-button__icon-copy--hover) { transform: none; }
  }

  @media (max-width: 809px) {
    .error-hero { min-height: 0; padding: 102px 0 60px; }
    .error-content { width: min(calc(100% - 60px), 700px); }
    .error-code { font-size: 100px; line-height: .7; letter-spacing: normal; }
    .error-content h1 { margin-top: 20px; font-size: 24px; line-height: 1.2; }
    .error-content p { max-width: none; margin: 4px auto 0; font-size: 18px; line-height: 1.4; }
    :global(.error-content .error-button) { width: 176.28px; min-height: 44px; margin-top: 16px; font-size: 16px; }
  }
</style>
