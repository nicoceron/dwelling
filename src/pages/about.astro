---
import BaseLayout from "../layouts/BaseLayout.astro";
import Button from "../components/Button.astro";

const assets = "/assets/framerusercontent.com/images/";

const principles = [
  {
    icon: "JfGMX17l4us1x26WPFoEG9eV3o.svg",
    title: "Clarity over complexity",
    copy: "We design features that are easy to understand and simple to use.",
    tone: "purple",
  },
  {
    icon: "aP3hl3lOeGzxt12VLKmP9eiUO9k.svg",
    title: "Real workflows",
    copy: "Everything is built around how teams actually work day to day.",
    tone: "green",
  },
  {
    icon: "GVnwnzYNASdpnelwXLScobwbnQ.svg",
    title: "Less manual work",
    copy: "Automation handles repetitive tasks so teams can focus on what matters.",
    tone: "pink",
  },
  {
    icon: "8CIzg6BHVQWYGFYIqzEN2YtKCU.svg",
    title: "Reliable performance",
    copy: "The platform stays fast, stable, and dependable as teams grow.",
    tone: "orange",
  },
];

const problems = [
  "Too many disconnected tools for basic work",
  "No single view of tasks, clients, and progress",
  "Spreadsheets used to track revenue and status",
  "Lost context between teams and clients",
  "Software that adds complexity instead of clarity",
];

const audiences = [
  ["Agencies", "Consultants", "Service teams", "Small businesses", "Freelancers"],
  ["Startups", "Operations teams", "Client-Facing teams", "Internal teams"],
  ["Growing companies", "Professional services", "Remote teams", "Operations managers"],
  ["Growing agencies", "IT services", "Support reams", "Product reams", "Client services"],
];

const team = [
  ["ncRhnlNTCt6XuPpGDLSFWVmMHQ.jpg", "Michael Anderson", "Product Lead"],
  ["A3y9FWLXgLPysTq4pqJxron2os4.jpg", "Sarah Collins", "UX & Research"],
  ["bAf3KTTnpLucpXHtXKuzVitvog.jpg", "Jason Miller", "Engineering"],
  ["fMPfq8vQcF3qEGzDXRj512WmAE.jpg", "Laura Bennett", "Customer Success"],
  ["W9UPf0ANa03MoOZaUouUZ4Qb3E.jpg", "Mark Sullivan", "Operations"],
];

---

<BaseLayout
  title="About | Worklane"
  description="Learn why Worklane was built for teams that manage real work and clients."
>
  <div class="about-page">
    <section class="about-hero" data-reveal>
      <div class="hero-shell">
        <div class="hero-top" data-reveal-child>
          <span class="section-kicker"><i></i>About us<i></i></span>
          <h1>Work stays simple when<br class="desktop-break" /> everything is in one place</h1>
          <p>Manage daily tasks, client work, and progress in one place<br class="desktop-break" /> without dealing with complex workflows or scattered tools.</p>
        </div>

        <div class="hero-bottom" data-reveal-child>
          <div class="hero-team-image image-frame">
            <img src={`${assets}AgPqpf8Wj3wlzl35x8MCxFGG52E.jpg`} alt="A team collaborating around a table" />
          </div>
          <div class="hero-storage image-frame">
            <img class="landscape" src={`${assets}Jf3yC1yuQINFcPICdzxr5VUsnE.jpg`} alt="A flower-covered landscape beneath clouds" />
            <img class="storage-card" src={`${assets}L2721AQXYgSsOa6eSNqJe0DvWeo.svg`} alt="Available storage card" />
          </div>
        </div>

        <div class="impact-panel" data-reveal-child>
          <div class="impact-glow" aria-hidden="true"></div>
          <div class="impact-copy">
            <span class="section-kicker section-kicker--dark"><i></i>Our impact so far<i></i></span>
            <div class="impact-bottom">
              <div class="impact-primary"><strong data-rolling-counter>2500<span class="impact-suffix">+</span></strong><small>Tasks completed every month</small></div>
              <div class="impact-stats">
                <div><strong data-rolling-counter>30<span class="impact-suffix">+</span></strong><small>Countries served</small></div>
                <div><strong data-rolling-counter>99<span class="impact-suffix">+</span></strong><small>Platform uptime</small></div>
                <div><strong data-rolling-counter>1<span class="impact-suffix">M</span></strong><small>Updates tracked</small></div>
              </div>
            </div>
          </div>
          <img class="impact-dashboard" src={`${assets}qXWeUGMpJuiovM9X40QHJFgrjI.png`} alt="Worklane dashboard" />
        </div>
      </div>
    </section>

    <section class="problem-section" data-reveal>
      <div class="problem-inner">
        <div class="problem-left" data-reveal-child>
          <h2>Why we built this<br class="desktop-break" /> platform for teams<br class="desktop-break" /> that manage real work</h2>
          <Button href="/request-demo" icon="→">Explore the product</Button>
        </div>
        <div class="problem-right" data-reveal-child>
          <p>Modern teams are expected to move fast, stay organized, and keep clients happy. But most teams end up juggling too many tools just to get through the day.</p>
          <ul>
            {problems.map((problem) => <li><img src="/assets/framerusercontent.com/images/olkYM0skJ2B8GdjI86gnn8qG4oc.svg" width="14" height="12" alt="" /><p>{problem}</p></li>)}
          </ul>
        </div>
      </div>
    </section>

    <section class="focus-section" data-reveal>
      <div class="focus-inner">
        <div class="focus-heading" data-reveal-child>
          <span class="section-kicker"><i></i>Our focus<i></i></span>
          <h2>What guides<br class="mobile-break" /> everything we build</h2>
        </div>
        <div class="principle-grid">
          {principles.map((principle) => (
            <article class="principle-card" data-reveal-child>
              <span class:list={["principle-icon", principle.tone]}>
                <img src={`${assets}${principle.icon}`} alt="" />
              </span>
              <div>
                <h3>{principle.title}</h3>
                <p>{principle.copy}</p>
              </div>
            </article>
          ))}
        </div>
      </div>
    </section>

    <section class="audience-section" data-reveal>
      <div class="audience-inner">
        <div class="audience-card" data-reveal-child>
          <div class="audience-card__glow audience-card__glow--top" aria-hidden="true"></div>
          <div class="audience-card__glow audience-card__glow--bottom" aria-hidden="true"></div>
          <div class="audience-card__pattern"></div>
          <div class="audience-card__pattern audience-card__pattern--bottom"></div>
          <div class="audience-card__top">
            <div class="avatar-stack">
              <img src={`${assets}hYfCvJ3IVdEznEOwIQiiAxWOsPY.jpg`} alt="" />
              <img src={`${assets}P0sSNnMlhW7adaGkZFmKHL828bY.jpg`} alt="" />
              <img src={`${assets}X0ECJ5xGgYrCVgHB8RYd3RABTQ.jpg`} alt="" />
            </div>
            <strong>10,000<span>+</span></strong>
            <p>Teams managing daily<br /> work on the platform</p>
          </div>
          <div class="audience-tags">
            {audiences.map((row) => <div>{[...row, ...row, ...row].map((tag, index) => <span aria-hidden={index >= row.length ? "true" : undefined}>{tag}</span>)}</div>)}
          </div>
        </div>
        <div class="audience-copy" data-reveal-child>
          <span class="section-kicker"><i></i>Who it’s for<i></i></span>
          <h2>Built for teams<br class="desktop-break" /> that manage<br class="desktop-break" /> work and clients</h2>
          <p>The platform is designed for teams that need visibility across tasks, clients, and progress without juggling multiple tools.</p>
          <Button href="/contact" icon="→">Get started now</Button>
        </div>
      </div>
    </section>

    <section class="team-section" data-reveal>
      <div class="team-inner">
        <div class="team-heading" data-reveal-child>
          <span class="section-kicker"><i></i>Our team<i></i></span>
          <h2>The people behind<br /> the product</h2>
        </div>
        <div class="team-grid">
          {team.map(([image, name, role]) => (
            <article class="team-member" data-reveal-child>
              <div class="team-photo">
                <img src={`${assets}${image}`} alt={name} />
                <a class="team-social" href="https://x.com/" target="_blank" rel="noopener" aria-label={`${name} on X`}><span aria-hidden="true">X</span><span aria-hidden="true">X</span></a>
              </div>
              <h3>{name}</h3>
              <p>{role}</p>
            </article>
          ))}
        </div>
      </div>
    </section>
  </div>
</BaseLayout>

<style>
  .about-page {
    --about-max: 1240px;
    overflow: hidden;
  }

  .about-page :is(h1, h2, h3, p) { text-wrap: balance; }
  .about-page h1,
  .about-page h2,
  .about-page h3 { color: var(--ink); letter-spacing: normal; }
  .about-page p { color: var(--muted); }
  .mobile-break { display: none; }

  .section-kicker {
    display: inline-flex;
    align-items: center;
    gap: 10px;
    min-height: 33px;
    padding: 7px 14px;
    border: 1px solid rgba(10, 11, 11, .1);
    border-radius: 10px;
    background: rgba(255,255,255,.75);
    color: var(--ink);
    font-size: 14px;
    line-height: 1.2;
    letter-spacing: .3px;
  }
  .section-kicker i { width: 4px; height: 4px; border-radius: 50%; background: currentColor; }
  .section-kicker--dark { border-color: rgba(255,255,255,.13); background: rgba(255,255,255,.08); color: #fff; }

  .about-hero { min-height: 1540px; }
  .hero-shell { width: min(calc(100% - 200px), var(--about-max)); margin-inline: auto; padding-top: 120px; }
  .hero-top { width: calc((100% - 60px) * .66); margin-left: 30px; }
  .hero-top h1 { margin-top: 10px; font-size: clamp(50px, 4.3vw, 62px); line-height: 1.1; }
  .hero-top p { margin-top: 10px; font-size: 18px; line-height: 1.4; }
  .hero-bottom { display: grid; grid-template-columns: repeat(6, minmax(0, 1fr)); gap: 30px; margin: 50px 30px 0; }
  .hero-team-image { grid-column: span 4; }
  .hero-storage { grid-column: span 2; }
  .image-frame { position: relative; overflow: hidden; border-radius: 20px; }
  .hero-team-image, .hero-storage { height: 423.84px; }
  .hero-team-image img { width: 100%; height: 100%; object-fit: cover; }
  .hero-storage .landscape { width: 100%; height: 100%; object-fit: cover; }
  .storage-card { position: absolute; inset: 9.5% auto auto 10.7%; width: 78.6%; height: auto; }
  .impact-panel { position: relative; display: flex; min-height: 526.78px; margin: 30px; overflow: hidden; border-radius: 20px; background: #0a0b0b; color: #fff; isolation: isolate; }
  .impact-panel::before { position: absolute; inset: -50px -50px 100px; z-index: 2; background: url("/assets/framerusercontent.com/images/IaNCr2d8JUTUZ2bOx135NYqB2wQ.svg") center / cover no-repeat; content: ""; pointer-events: none; }
  .impact-glow { position: absolute; top: -80px; right: -120px; left: -120px; z-index: 0; height: 430px; background: url("/assets/framerusercontent.com/images/seIhs21UXYUkf8mIG3R0bMEJFg.svg") center / contain no-repeat; filter: blur(80px); opacity: .8; pointer-events: none; }
  .impact-panel::after { position: absolute; inset: 0; z-index: 1; background: #000; opacity: .5; content: ""; pointer-events: none; }
  .impact-copy { position: relative; z-index: 3; display: flex; flex: none; flex-direction: column; align-items: flex-start; gap: 160px; width: 515px; height: 386.78px; margin: 70px; }
  .impact-bottom { display: grid; gap: 50px; width: 100%; }
  .impact-primary strong { display: block; font-family: "Stack Sans Headline", sans-serif; font-size: 62px; line-height: .8; }
  .impact-primary strong .impact-suffix { color: var(--purple); }
  .impact-copy small { display: block; margin-top: 16px; color: rgba(255,255,255,.6); font-size: 14px; line-height: 1.2; letter-spacing: .3px; }
  .impact-stats { display: flex; gap: 68px; }
  .impact-stats strong { display: block; font-family: "Stack Sans Headline", sans-serif; font-size: 36px; line-height: .8; }
  .impact-stats div:nth-child(1) strong .impact-suffix { color: var(--blue); }
  .impact-stats div:nth-child(2) strong .impact-suffix { color: var(--pink); }
  .impact-stats div:nth-child(3) strong .impact-suffix { color: var(--green); }
  .impact-dashboard { position: absolute; z-index: 3; right: -215px; bottom: 0; width: 700px; max-width: none; transform: matrix(.996195, -.0871557, .354085, .972841, 0, 0); opacity: 1; }

  :global(.problem-left .button),
  :global(.audience-copy .button) { height: 52px; min-height: 52px; gap: 12px; padding: 4px 18px 4px 4px; border: 0; border-radius: 16px; background: linear-gradient(180deg, #0a0b0b 0%, #363b3c 100%); font-family: "Inter Display", sans-serif; font-size: 18px; font-weight: 600; line-height: 1.3; }
  :global(.problem-left .button .button__icon-window),
  :global(.audience-copy .button .button__icon-window) { width: 44px; height: 44px; flex-basis: 44px; border-radius: 12px; background: linear-gradient(180deg, #fff 0%, #c9c9c9 100%); color: #0a0b0b; }

  .problem-section { min-height: 419px; }
  .problem-inner { display: grid; grid-template-columns: 1.25fr 1fr; gap: 60px; width: min(calc(100% - 200px), 1180px); margin-inline: auto; }
  .problem-left h2 { font-size: 52px; line-height: 1.2; }
  :global(.problem-left .button) { width: 240.3px; min-height: 52px; margin-top: 30px; }
  .problem-right { padding-top: 0; }
  .problem-right > p { font-size: 18px; line-height: 1.4; }
  .problem-right ul { display: grid; gap: 12px; margin: 30px 0 0; padding: 0; list-style: none; color: var(--ink); font-size: 16px; line-height: 1.2; letter-spacing: .3px; text-wrap: balance; }
  .problem-right li { display: flex; align-items: flex-start; gap: 10px; }
  .problem-right li img { display: block; width: 14px; height: 12px; flex: 0 0 14px; margin-top: 3px; }
  .problem-right li p { flex: 1; min-width: 0; margin: 0; color: var(--ink); font-family: "Inter Display", sans-serif; font-size: 16px; font-weight: 500; letter-spacing: .3px; line-height: 19.2px; text-wrap: balance; }

  .focus-section { min-height: 960.81px; margin-inline: 30px; padding: 150px 100px; border-radius: 20px; background: var(--wash); }
  .focus-heading { max-width: 700px; margin-inline: auto; text-align: center; }
  .focus-heading h2 { margin-top: 10px; font-size: 52px; line-height: 1.2; }
  .principle-grid { display: grid; grid-template-columns: repeat(4, 1fr); gap: 30px; margin-top: 50px; }
  .principle-card { min-height: 293.2px; padding: 29px; border: 1px solid var(--line); border-radius: 20px; background: #fff; }
  .principle-icon { display: grid; width: 40px; height: 40px; place-items: center; border-radius: 10px; }
  .principle-icon img { width: 22px; height: 22px; object-fit: contain; }
  .principle-icon.purple { border: 1px solid #674cd0; background: linear-gradient(144deg, #674cd0 0%, #a8a8ff 100%); }
  .principle-icon.green { border: 1px solid #67a429; background: linear-gradient(144deg, #67a429 0%, #aee576 100%); }
  .principle-icon.pink { border: 1px solid #f045aa; background: linear-gradient(144deg, #f045aa 0%, #eeaad2 100%); }
  .principle-icon.orange { border: 1px solid #fa8837; background: linear-gradient(144deg, #fa8837 0%, #faac75 100%); }
  .principle-card > div { margin-top: 50px; }
  .principle-card h3 { font-family: "Stack Sans Headline", sans-serif; font-size: 22px; font-weight: 600; line-height: 1.4; }
  .principle-card p { margin-top: 6px; color: #545454; font-size: 18px; line-height: 1.4; }

  .audience-section { min-height: 636px; margin-top: 0; }
  .audience-inner { display: grid; grid-template-columns: repeat(2, minmax(0, 1fr)); align-items: center; gap: 60px; width: min(calc(100% - 200px), 1180px); min-height: 485.63px; margin-inline: auto; }
  .audience-card { position: relative; display: block; min-height: 485.63px; overflow: hidden; border-radius: 20px; background: #0a0b0b; color: #fff; isolation: isolate; }
  .audience-card__glow { position: absolute; right: -40px; left: -40px; z-index: 0; height: 80px; border-radius: 50%; filter: blur(70px); opacity: .5; pointer-events: none; }
  .audience-card__glow--top { top: -40px; background: #6b10e4; }
  .audience-card__glow--bottom { bottom: -40px; background: #1774de; }
  .audience-card__pattern { position: absolute; top: -40px; right: -40px; left: -40px; z-index: 0; aspect-ratio: 575 / 218; background: url("/assets/framerusercontent.com/images/DR9RuTqYcKJVZ75ladALY19SLmg.svg") center / 100% 100% no-repeat; opacity: .1; pointer-events: none; }
  .audience-card__pattern--bottom { top: auto; bottom: -40px; transform: rotateX(180deg); }
  .audience-card__top { position: relative; z-index: 1; display: grid; justify-items: center; width: 300px; margin: 40px auto 0; text-align: center; }
  .avatar-stack { display: flex; justify-content: center; height: 50px; margin-bottom: 16px; }
  .avatar-stack img { width: 40px; height: 40px; margin-inline: -5px; border: 2px solid #f8ad47; border-radius: 50%; object-fit: cover; }
  .avatar-stack img:nth-child(2) { width: 50px; height: 50px; margin-top: -5px; }
  .audience-card__top strong { color: transparent; font-family: "Stack Sans Headline", sans-serif; font-size: 52px; font-weight: 500; line-height: 1.2; background: linear-gradient(280deg, #a8a8ff 0%, #674cd0 100%); background-clip: text; -webkit-background-clip: text; }
  .audience-card__top p { margin-top: 12px; color: #a4a4a4; font-size: 18px; font-weight: 500; line-height: 1.4; }
  .audience-tags { position: absolute; right: 40px; bottom: 40px; left: 40px; z-index: 1; display: grid; gap: 20px; }
  .audience-tags div { display: flex; width: max-content; justify-content: flex-start; gap: 10px; white-space: nowrap; }
  .audience-tags div:nth-child(1) { --audience-offset: -818.4px; animation: audience-left 44.5s linear infinite; }
  .audience-tags div:nth-child(2) { --audience-offset: -491.6px; animation: audience-right 40s linear infinite; }
  .audience-tags div:nth-child(3) { --audience-offset: -869.4px; animation: audience-left 47.7s linear infinite; }
  .audience-tags div:nth-child(4) { --audience-offset: -620.6px; animation: audience-right 48.4s linear infinite; }
  @keyframes audience-left { from { transform: translateX(var(--audience-offset)); } to { transform: translateX(calc(var(--audience-offset) - 33.3333% - 3.333px)); } }
  @keyframes audience-right { from { transform: translateX(calc(var(--audience-offset) - 33.3333% - 3.333px)); } to { transform: translateX(var(--audience-offset)); } }
  .audience-tags span { padding: 6px 16px; border: 1px solid rgba(255,255,255,.1); border-radius: 100px; background: rgba(255,255,255,.05); color: #fff; font-size: 16px; font-weight: 500; line-height: 1.2; letter-spacing: normal; }
  .audience-copy { padding-left: 0; }
  .audience-copy h2 { margin-top: 10px; font-size: 52px; line-height: 1.2; }
  .audience-copy p { max-width: 500px; margin-top: 10px; font-size: 18px; line-height: 1.4; }
  :global(.audience-copy .button) { width: 211.63px; margin-top: 40px; }

  .team-section { min-height: 620px; }
  .team-inner { width: min(calc(100% - 200px), 1180px); margin-inline: auto; }
  .team-heading { text-align: center; }
  .team-heading h2 { margin-top: 10px; font-size: 52px; line-height: 1.2; }
  .team-grid { display: grid; grid-template-columns: repeat(5, 1fr); gap: 20px; max-width: 1180px; margin: 50px auto 0; }
  .team-member { text-align: center; }
  .team-photo { position: relative; display: block; width: 180px; margin-inline: auto; overflow: hidden; aspect-ratio: 1; border-radius: 17px; background: #ddd; }
  .team-photo img { width: 100%; height: 100%; object-fit: cover; }
  .team-photo::after { position: absolute; inset: 0; z-index: 1; background: linear-gradient(180deg, transparent 45%, rgba(10,11,11,.85) 100%); content: ""; opacity: 0; pointer-events: none; transition: opacity 350ms cubic-bezier(.44,0,.56,1); }
  .team-photo:hover::after, .team-photo:focus-within::after { opacity: 1; }
  .team-social { position: absolute; bottom: 16px; left: 50%; z-index: 2; display: block; width: 32px; height: 32px; overflow: hidden; border-radius: 50%; background: rgba(0,0,0,.45); color: #fff; font-size: 16px; opacity: 0; transform: translateX(-50%); transition: opacity 350ms cubic-bezier(.44,0,.56,1); }
  .team-social > span { display: grid; width: 32px; height: 32px; place-items: center; transition: transform 350ms cubic-bezier(.44,0,.56,1); }
  .team-social > span:last-child { position: absolute; top: 36px; left: 0; }
  .team-photo:hover .team-social, .team-photo:focus-within .team-social { opacity: 1; }
  .team-social:hover > span, .team-social:focus-visible > span { transform: translateY(-36px); }
  .team-member h3 { margin-top: 16px; font-family: "Stack Sans Headline", sans-serif; font-size: 22px; font-weight: 600; line-height: 1.4; }
  .team-member p { margin-top: 0; color: #545454; font-size: 18px; line-height: 1.4; }

  @media (max-width: 1199px) {
    .desktop-break { display: none; }
    .about-hero { min-height: 1337.6px; }
    .hero-shell { width: calc(100% - 60px); padding-top: 140px; }
    .hero-top { width: 66%; margin-left: 0; }
    .hero-top h1 { font-size: 50px; }
    .hero-bottom { grid-template-columns: repeat(6, minmax(0, 1fr)); gap: 30px; margin: 30px 0 0; }
    .hero-team-image, .hero-storage { height: 255.81px; }
    .storage-card { inset: 40px auto auto 40px; width: 150px; }
    .impact-panel { margin-inline: 0; min-height: 463.58px; }
    .impact-glow { height: 309px; }
    .impact-copy { width: 340px; height: 403.58px; margin: 30px; }
    .impact-dashboard { right: -430px; bottom: -40px; }
    .problem-section { min-height: 496.84px; }
    .problem-inner { width: calc(100% - 60px); grid-template-columns: 1.25fr 1fr; gap: 30px; }
    .problem-left h2 { font-size: 42px; line-height: 1.2; }
    :global(.problem-left .button),
    :global(.audience-copy .button) { height: 44px; min-height: 44px; border-radius: 12px; }
    :global(.problem-left .button .button__icon-window),
    :global(.audience-copy .button .button__icon-window) { width: 36px; height: 36px; flex-basis: 36px; border-radius: 10px; }
    :global(.problem-left .button) { width: 224.3px; }
    .problem-right > p { font-size: 18px; line-height: 1.4; }
    .problem-right ul { gap: 12px; margin-top: 30px; font-size: 16px; }
    .focus-section { min-height: 1012.81px; margin-inline: 30px; padding: 120px 30px; }
    .focus-heading h2 { font-size: 42px; line-height: 1.2; }
    .principle-grid { grid-template-columns: repeat(2, 1fr); gap: 30px; margin-top: 30px; }
    .principle-card { min-height: 0; padding: 29px; }
